local function sigm(z)
    if z > 30 then return 1 end
    if z < -30 then return 0 end
    return 1 / (1 + math.exp(-z))
end

local function edgeLL(ins, outs, upper, scale, e, wi, wo)
    local s = 0
    for i = 1, #ins do
        local z = upper and (ins[i] - e) / scale or (e - ins[i]) / scale
        s = s + (wi and wi[i] or 1) * math.log(math.max(1 - sigm(z), 1e-9))
    end
    for i = 1, #outs do
        local z = upper and (outs[i] - e) / scale or (e - outs[i]) / scale
        s = s + (wo and wo[i] or 1) * math.log(math.max(sigm(z), 1e-9))
    end
    return s
end

local function fitEdge(ins, outs, upper, scale, wi, wo)
    if #outs == 0 or #ins == 0 then return nil end
    local lo, hi = math.huge, -math.huge
    for _, x in ipairs(ins) do
        if x < lo then lo = x end
        if x > hi then hi = x end
    end
    for _, x in ipairs(outs) do
        if x < lo then lo = x end
        if x > hi then hi = x end
    end
    lo, hi = lo - scale * 2, hi + scale * 2
    local best, bestLL = lo, -math.huge
    for i = 0, 32 do
        local e = lo + (hi - lo) * i / 32
        local v = edgeLL(ins, outs, upper, scale, e, wi, wo)
        if v > bestLL then bestLL, best = v, e end
    end
    local w = (hi - lo) / 32
    for i = -8, 8 do
        local e = best + w * i / 8
        local v = edgeLL(ins, outs, upper, scale, e, wi, wo)
        if v > bestLL then bestLL, best = v, e end
    end
    return best
end

local function wquant(xs, ws, q)
    local idx = {}
    for i = 1, #xs do idx[i] = i end
    table.sort(idx, function(p, r) return xs[p] < xs[r] end)
    local tot = 0
    for i = 1, #ws do tot = tot + ws[i] end
    local acc = 0
    for _, i in ipairs(idx) do
        acc = acc + ws[i]
        if acc >= tot * q then return xs[i] end
    end
    return xs[idx[#idx]]
end

local function bracket(list, safe, scale, d0, sig)
    local ins, wi = {}, {}
    local pool = {}
    local wsum = 0
    for _, s in ipairs(list) do
        local w = 1
        if d0 and s.d then
            local dd = s.d - d0
            w = math.exp(-(dd * dd) / (2 * sig * sig))
        end
        if w >= 0.05 then
            pool[#pool + 1] = { x = s.x, c = s.c, w = w }
            wsum = wsum + w
            if s.c == "P" then
                ins[#ins + 1] = s.x
                wi[#wi + 1] = w
            end
        end
    end
    local np = #ins
    local med, p10, p90 = nil, nil, nil
    if np > 0 then
        med = wquant(ins, wi, 0.5)
        p10 = wquant(ins, wi, 0.1)
        p90 = wquant(ins, wi, 0.9)
    end
    local lows, lw, ups, uw = {}, {}, {}, {}
    local eMax, lMin = nil, nil
    for _, s in ipairs(pool) do
        local c = s.c
        if c == "N" then
            if med then c = (s.x < med) and "E" or "L" else c = nil end
        end
        if c == "E" then
            lows[#lows + 1] = s.x
            lw[#lw + 1] = s.w
            if eMax == nil or s.x > eMax then eMax = s.x end
        elseif c == "L" then
            ups[#ups + 1] = s.x
            uw[#uw + 1] = s.w
            if lMin == nil or s.x < lMin then lMin = s.x end
        end
    end
    if np == 0 then
        if eMax and lMin and lMin > eMax then return (eMax + lMin) / 2, 0, 0, eMax, lMin, nil, nil, wsum end
        return nil, 0, 0, eMax, lMin, nil, nil, wsum
    end
    local L = fitEdge(ins, lows, false, scale, wi, lw)
    local U = fitEdge(ins, ups, true, scale, wi, uw)
    local c
    if L and U and U > L then
        c = (L + U) / 2
    elseif U then
        c = math.min((p10 + U) / 2, U - safe)
    elseif L then
        c = math.max((L + p90) / 2, L + safe)
    else
        c = med
    end
    return c, np, p90 - p10, eMax, lMin, p10, p90, wsum
end

local function encSamples(list)
    local out = {}
    for i, s in ipairs(list) do out[i] = { s.x, s.c, s.d or -1 } end
    return out
end

local function decSamples(raw, into, cap)
    if type(raw) ~= "table" then return end
    for _, s in ipairs(raw) do
        if type(s) == "table" and type(s[1]) == "number" and (s[2] == "P" or s[2] == "E" or s[2] == "L" or s[2] == "N") then
            local dd = num(s[3], -1)
            into[#into + 1] = { x = s[1], c = s[2], d = dd >= 0 and dd or nil }
        end
    end
    while #into > cap do table.remove(into, 1) end
end

