local function fetch(url)
    local body = ""
    local ok, r = pcall(function() return httpget(url) end)
    if ok and type(r) == "string" then body = r end
    if #body < 100 then
        ok, r = pcall(function() return game:HttpGet(url) end)
        if ok and type(r) == "string" then body = r end
    end
    return body
end

local function loadLib()
    local src = fetch(LIB_URL)
    if #src < 100 then return nil, "download failed" end
    _G.__QL_RET = nil
    local lib = nil
    local okc, fn = pcall(loadstring, "_G.__QL_RET = (function(...)\n" .. src .. "\nend)()")
    if okc and type(fn) == "function" then pcall(fn) end
    lib = _G.__QL_RET
    _G.__QL_RET = nil
    if type(lib) ~= "table" then
        local okc2, fn2 = pcall(loadstring, src)
        if okc2 and type(fn2) == "function" then
            local ok2, r2 = pcall(fn2)
            if ok2 and type(r2) == "table" then lib = r2 end
        end
    end
    if type(lib) ~= "table" and type(_G.QuantomLib) == "table" then lib = _G.QuantomLib end
    if type(lib) ~= "table" then return nil, "load failed" end
    return lib
end

local function verNum(v)
    local a, b, c = string.match(tostring(v or ""), "^(%d+)%.(%d+)%.?(%d*)")
    return (tonumber(a) or 0) * 10000 + (tonumber(b) or 0) * 100 + (tonumber(c) or 0)
end

