    local start = now()
    local res, cov = nil, nil
    while alive and now() - start < 0.85 do
        local r = readResult()
        if r then res = r end
        local c = readCoverage()
        if c ~= nil then cov = c end
        task.wait(0.025)
    end
    return res, cov
end

local function newCand(o, path)
    local okp, par = pcall(rdParent, o)
    return { o = o, par = okp and par or nil, path = path, v = { {}, {}, {}, {} }, t = {}, passes = 0 }
end

local function sampleCand(c, t)
    local par = c.par
    if not par then return end
    local ok1, s = pcall(rdAbsSize, c.o)
    if not ok1 or not s then return end
    local ok2, p = pcall(rdAbsPos, c.o)
    if not ok2 or not p then return end
    local ok3, ps = pcall(rdAbsSize, par)
    if not ok3 or not ps or ps.X < 2 or ps.Y < 2 then return end
    local ok4, pp = pcall(rdAbsPos, par)
    if not ok4 or not pp then return end
    local n = #c.t + 1
    c.t[n] = t
    c.v[1][n] = s.X / ps.X
    c.v[2][n] = s.Y / ps.Y
    c.v[3][n] = (p.X - pp.X) / ps.X
    c.v[4][n] = (p.Y - pp.Y) / ps.Y
end

local function readChan(c, ch)
    local o, par = c.o, c.par
    if not par then return nil end
    if ch == 1 or ch == 2 then
        local ok, s = pcall(rdAbsSize, o)
        if not ok or not s then return nil end
        local ok2, ps = pcall(rdAbsSize, par)
        if not ok2 or not ps then return nil end
        if ch == 1 then
            if ps.X < 2 then return nil end
            return s.X / ps.X
        end
        if ps.Y < 2 then return nil end
        return s.Y / ps.Y
    end
    local ok, p = pcall(rdAbsPos, o)
    if not ok or not p then return nil end
    local ok2, pp = pcall(rdAbsPos, par)
    if not ok2 or not pp then return nil end
    local ok3, ps = pcall(rdAbsSize, par)
    if not ok3 or not ps then return nil end
    if ch == 3 then
        if ps.X < 2 then return nil end
        return (p.X - pp.X) / ps.X
    end
    if ps.Y < 2 then return nil end
    return (p.Y - pp.Y) / ps.Y
end

local function collect(rootObj)
    local out = {}
    local function walk(o, path, depth)
        if depth > 8 or #out >= 80 then return end
        local ok, kids = pcall(rdKids, o)
        if not ok or type(kids) ~= "table" then return end
        for _, k in ipairs(kids) do
            if #out >= 80 then return end
            local okn, nm = pcall(rdName, k)
            if okn and nm then
                local p = {}
                for i = 1, #path do p[i] = path[i] end
                p[#p + 1] = tostring(nm)
                out[#out + 1] = newCand(k, p)
                walk(k, p, depth + 1)
            end
        end
    end
    walk(rootObj, {}, 0)
    return out
end

local function resolve(rootObj, path)
    local cur = rootObj
    for _, nm in ipairs(path) do
        if not cur then return nil end
        local ok, nx = pcall(rdFind, cur, nm)
        if not ok then return nil end
        cur = nx
    end
    return cur
end

local function samePath(a, b)
    if not a or not b or #a ~= #b then return false end
    for i = 1, #a do if a[i] ~= b[i] then return false end end
    return true
end

local function pathKey(p)
    return table.concat(p, "\1")
end

local function prune(cands, lockC, el)
    local i = 1
    while i <= #cands do
        local c = cands[i]
        local drop = false
        if c ~= lockC then
            local n = #c.t
            if n == 0 and c.passes >= 2 then
                drop = true
            elseif el >= 0.1 and n >= 4 then
                local moved = false
                for ch = 1, 4 do
                    local lo, hi = math.huge, -math.huge
                    for _, v in ipairs(c.v[ch]) do
                        if v < lo then lo = v end
                        if v > hi then hi = v end
                    end
                    if hi - lo > 0.005 then moved = true break end
                end
                drop = not moved
            end
        end
        if drop then table.remove(cands, i) else i = i + 1 end
    end
end

local function analyze(cands)
    local best, bestS = nil, 0
    for _, c in ipairs(cands) do
        local n = #c.t
        if n >= 4 then
            for ch = 1, 4 do
                local vals = c.v[ch]
                if #vals == n then
                    local dv = vals[n] - vals[1]
                    local ad = math.abs(dv)
                    if ad >= 0.12 and ad <= 1.6 then
                        local sg = dv > 0 and 1 or -1
                        local good, tot = 0, 0
                        for i = 2, n do
                            local st = vals[i] - vals[i - 1]
                            if math.abs(st) > 1e-4 then
                                tot = tot + 1
                                if st * sg > 0 then good = good + 1 end
                            end
                        end
                        if tot >= 3 and good / tot >= 0.85 then
                            local s = ad * (good / tot) * math.min(1, tot / (n - 1) + 0.3)
                            if s > bestS then
                                bestS = s
                                best = { path = c.path, ch = ch, sgn = sg, cand = c }
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local function dedupe(ts, vs, sgn)
    local hist, last = {}, nil
    for i = 1, #ts do
        local v = vs[i]
        if v then
            v = v * sgn
            if last == nil or math.abs(v - last) > 1e-6 then
                hist[#hist + 1] = { t = ts[i], v = v }
                last = v
            end
        end
    end
    return hist
end

local function rateOf(hist)
    local hn = #hist
    if hn < 3 then return nil end
    local tl = hist[hn].t
    local k = hn - 2
    while k > 1 and tl - hist[k - 1].t <= 0.1 do k = k - 1 end
    local dt = tl - hist[k].t
    if dt <= 0 then return nil end
    return (hist[hn].v - hist[k].v) / dt, clamp(dt / (hn - k), 1 / 400, 1 / 15)
end

local function frameMean(hist)
    local i0 = 2
    if #hist >= 2 and hist[1].v > 1e-4 then i0 = 1 end
    local n = #hist - i0
    if n < 3 then return nil end
    local dt = hist[#hist].t - hist[i0].t
    if dt <= 0 then return nil end
    return dt / n
end

local function updateLockFromHist(hist)
    if #hist >= 4 and hist[#hist].v - hist[1].v >= 0.12 then
        BAR.lock = math.min(BAR.lock + 1, 5)
        return true
    end
    BAR.lock = BAR.lock - 1
    if BAR.lock <= 0 then resetBar() end
    return false
end

local function updateLockFromBest(best)
    if best then
        if BAR.path and samePath(best.path, BAR.path) and best.ch == BAR.ch and best.sgn == BAR.sgn then
            BAR.lock = math.min(BAR.lock + 1, 5)
            return true
        end
        if BAR.lock <= 1 then
            resetBar()
            BAR.path, BAR.ch, BAR.sgn, BAR.lock = best.path, best.ch, best.sgn, 1
            return true
        end
        BAR.lock = BAR.lock - 1
        return false
    end
    if BAR.path then
        BAR.lock = BAR.lock - 1
        if BAR.lock <= 0 then resetBar() end
    end
    return false
end

local function stepWait()
    local a = now()
    task.wait()
    local d = now() - a
    if d > 0 and d < 0.25 then ST.step = ST.step + (d - ST.step) * 0.2 end
end

local function calibrate()
    for i = 1, 20 do stepWait() end
    local fs = {}
    for i = 1, 7 do
        local a = now()
        task.wait(0.002)
        fs[#fs + 1] = now() - a
    end
    table.sort(fs)
    ST.fine = fs[4] < 0.006 and fs[4] < ST.step * 0.6
    ST.bias = ST.fine and 1 or ST.step * 500
    if BAR.fine ~= nil and BAR.fine ~= ST.fine then
        BAR.S, BAR.Pc = {}, nil
    end
    BAR.fine = ST.fine
    ST.calib = true
end



local function release(vk)
    pcall(keyrelease, vk)
end

local function pauseUI(b)
    if C.pauseUi and Lib and Lib.SetRenderPaused then pcall(Lib.SetRenderPaused, Lib, b) end
end

local function gradeIndex(name)
    for i, n in ipairs(GRADES) do if n == name then return i end end
    return 1
end

local function pickGrade()
    local tg = gradeIndex(C.target)
    local hit = rand() * 100 < C.chance
    if tg == 1 and C.maxStreak > 0 and ST.streak >= C.maxStreak then hit = false end
    if hit then return tg end
    local mg = C.missGrade
    if mg == "Random (Great/Good)" then return (rand() < 0.5) and 2 or 3 end
    if mg == "Random (Any)" then return 2 + math.floor(rand() * 5) end
    return gradeIndex(mg)
end

local function gradeOffset(g)
    local j = 0
    if C.jitter > 0 then j = (rand() * 2 - 1) * C.jitter end
    if g <= 1 then return j, 0 end
    local sd = 1
    if C.side == "Early" then sd = -1
    elseif C.side == "Late" then sd = 1
    elseif rand() < 0.5 then sd = -1 end
    local mag = (sd < 0) and GDE[g] or GDL[g]
    return sd * mag + j, sd
end

local function fixGrades(t)
    for i = 2, 6 do
        local lo = t[i - 1] + 2
        if t[i] < lo then t[i] = lo end
        if t[i] > 150 then t[i] = 150 end
    end
end

local function learnGrade(g, res, sd)
    if g <= 1 or not res or sd == 0 then return end
    local r = RANK[res]
    if not r then return end
    local t = (sd < 0) and GDE or GDL
    local isEarly = string.find(res, "EARLY", 1, true) ~= nil
    local isLate = string.find(res, "LATE", 1, true) ~= nil
    if r < g then
        t[g] = t[g] + 3
    elseif r > g then
        if (sd < 0 and isLate) or (sd > 0 and isEarly) then t[g] = t[g] + 3 else t[g] = t[g] - 3 end
    end
    fixGrades(t)
end

local function processResult(sh, res, cov)
    ST.shots = ST.shots + 1
    if sh.manual then
        ST.miss = ST.miss + 1
        ST.last = "MANUAL"
        ST.lastMode = sh.mode
        if C.log then print("[BASKETBALL] released manually, shot ignored") end
        ST.dirty = true
        return
    end
    if res == "PERFECT" then ST.perfect = ST.perfect + 1 ST.streak = ST.streak + 1 else ST.streak = 0 end
    if res == "GREAT" then ST.great = ST.great + 1 end
    if res == "GOOD" then ST.goodOnly = ST.goodOnly + 1 end
    if res == "GOOD" or res == "GREAT" then ST.good = ST.good + 1
    elseif res and string.find(res, "EARLY", 1, true) then ST.early = ST.early + 1
    elseif res and string.find(res, "LATE", 1, true) then ST.late = ST.late + 1
    elseif res ~= "PERFECT" then ST.miss = ST.miss + 1 end
    if res then
        ST.attempts = ST.attempts + 1
        if RANK[res] == sh.grade then ST.hits = ST.hits + 1 end
    end
    ST.lastTarget = GRADES[sh.grade] or "?"
    ST.lastExtra = sh.extra
    ST.last = res or "?"
    ST.lastD = sh.dist
    ST.lastDelay = sh.actual or 0
    ST.lastPred = sh.aim
    ST.lastMode = sh.mode

    local cls = res and CLS[res] or nil

    if cls and sh.actual then
        if C.learn then
            sh.r = sh.actual - sh.base
            learnTime(sh, cls)
        end
        if C.gradeLearn then learnGrade(sh.grade, res, sh.sdir) end
        if C.mode == 0 then
            local px, prate = sh.px, sh.prate
            local hist = sh.hist
            if sh.lockedShot then
                updateLockFromHist(hist)
            elseif sh.cands then
                local best = analyze(sh.cands)
                if updateLockFromBest(best) and best then
                    if not (px and samePath(best.path, sh.lockPath or {}) and best.ch == sh.lockCh) then
                        hist = dedupe(best.cand.t, best.cand.v[best.ch], best.sgn)
                        local r, d = rateOf(hist)
                        if r and r > 0 then
                            px, prate = hist[#hist].v + r * (BAR.gdt or d), r
                        else
                            px = nil
                        end
                    end
                else
                    px = nil
                end
            end
            if hist and #hist >= 6 then
                local fmn = frameMean(hist)
                if fmn then
                    if BAR.gdt == nil or math.abs(fmn - BAR.gdt) > BAR.gdt * 0.5 then
                        BAR.gdtN = (BAR.gdtN or 0) + 1
                        if BAR.gdt == nil or BAR.gdtN >= 3 then
                            BAR.gdt, BAR.gdtN = fmn, 0
                        end
                    else
                        BAR.gdt = BAR.gdt * 0.8 + fmn * 0.2
                        BAR.gdtN = 0
                    end
                end
            end
            if px and BAR.path and C.learn then
                learnMeter(px, prate, cls)
                if sh.mode == "METER" and sh.grade == 1 and math.abs(sh.extra) <= 8 then
                    if cls == "P" then BAR.miss = 0 else BAR.miss = BAR.miss + 1 end
                    if BAR.miss >= 6 then
                        BAR.S, BAR.Pc, BAR.miss = {}, nil, 0
                        if C.log then print("[BASKETBALL] meter target relearning") end
                    end
                end
            end
        end
    end

    if C.log then
        print(string.format(
            "#%d | D:%.1f | want %s (%+.0fms) | %s %.0fms (aim %.0f) | %s | C:%s | P:%s | R:%.1f L:%.1f | x:%s Pc:%s L%d | center:%.1fms frame:%.1fms",
            ST.shots, sh.dist, GRADES[sh.grade] or "?", sh.extra, sh.mode, sh.actual or 0, sh.aim, res or "?",
            cov and (tostring(round1(cov)) .. "%") or "?",
            sh.ping and tostring(sh.ping) or "?",
            sh.mv.radial, sh.mv.lateral,
            sh.px and string.format("%.3f", sh.px) or "-", BAR.Pc and string.format("%.3f", BAR.Pc) or "-", BAR.lock, timeCenter(), (BAR.gdt or 0) * 1000
        ))
    end
    ST.dirty = true
end

local function shoot(t0, vk)
    local root = getRoot()
    if not root then
        if C.log then print("[BASKETBALL] no character") end
        return
    end
    local hoop, dist, facing, rp = getTarget(root)
    if not hoop then
        if C.log then print("[BASKETBALL] hoop not found") end
        return
    end
    if dist < C.minDist or dist > C.maxDist then
        ST.skipped = ST.skipped + 1
        ST.last = "SKIPPED"
        ST.lastD = dist
        if C.log then print(string.format("[BASKETBALL] distance %.1f outside %d-%d, not touching this shot", dist, C.minDist, C.maxDist)) end
        return
    end
    local grade = pickGrade()
    local extra, sdir = gradeOffset(grade)
    local ping = ST.ping
    local mv = getMovement(root, hoop, rp)
    local xp, xr, xl = features(mv, ping)
    local base, a, b, f = baseTime(dist, xp, xr, xl)
    local aim = clamp(base + timeCenterAt(dist) + C.off + extra, D_MIN, D_MAX)
    local tgt = t0 + aim / 1000
    local sh = {
        a = a, b = b, f = f, xp = xp, xr = xr, xl = xl, base = base, aim = aim,
        grade = grade, extra = extra, sdir = sdir, dist = dist, mv = mv, ping = ping
    }
    local fine = ST.fine
    local useBar = C.mode == 0 and barReady()
    local locked = C.mode == 0 and BAR.path ~= nil and BAR.lock >= 3
    local info, cands, lockC, recol = nil, nil, nil, false
    local hist, lastV = {}, nil
    local mode = useBar and "METER" or "TIME"
    local ups, lastStore = 0, 0
    local offs = (C.off + extra) / 1000
    local pc = BAR.Pc
    local lockCh, lockSgn = BAR.ch, BAR.sgn
    local loopStep = fine and 0.002 or ST.step
    local sampleEvery = fine and 0.006 or 0.0015
    sh.lockPath = BAR.path
    sh.lockCh = lockCh
    sh.lockedShot = locked

    while alive do
        local n0 = now()
        local el0 = n0 - t0
        if C.mode == 0 then
            if not info then info = getShotInfo() end
            if info and not cands then
                if locked then
                    local o = resolve(info, BAR.path)
                    if o then
                        lockC = newCand(o, BAR.path)
                        cands = { lockC }
                    end
                else
                    local list = collect(info)
                    if #list > 0 then
                        cands = list
                        if BAR.path then
                            for _, c in ipairs(list) do
                                if samePath(c.path, BAR.path) then lockC = c break end
                            end
                        end
                    end
                end
            elseif info and cands and not locked and not recol and el0 >= 0.08 then
                recol = true
                local have = {}
                for _, c in ipairs(cands) do have[pathKey(c.path)] = true end
                for _, c in ipairs(collect(info)) do
                    if not have[pathKey(c.path)] then
                        cands[#cands + 1] = c
                        if not lockC and BAR.path and samePath(c.path, BAR.path) then lockC = c end
                    end
                end
            end
            if cands and not locked and n0 - lastStore >= sampleEvery then
                lastStore = n0
                for _, c in ipairs(cands) do
                    c.passes = c.passes + 1
                    sampleCand(c, n0)
                end
                prune(cands, lockC, el0)
            end
            if lockC then
                local v = readChan(lockC, lockCh)
                if v then
                    if locked then
                        local k = #lockC.t + 1
                        lockC.t[k] = n0
                        lockC.v[lockCh][k] = v
                    end
                    v = v * lockSgn
                    if lastV == nil or math.abs(v - lastV) > 1e-6 then
                        hist[#hist + 1] = { t = n0, v = v }
                        lastV = v
                    end
                end
            end
        end

        local n = now()
        local el = n - t0
        local fire = false
        if mode == "METER" then
            local hn = #hist
            if hn >= 3 then
                local rate, dEst = rateOf(hist)
                local d = BAR.gdt or dEst
                if hist[hn].v < hist[hn - 1].v - 0.15 then
                    mode = "TIME*"
                elseif rate and rate > 0 and el >= aim / 2000 then
                    local stepE = math.max(loopStep, d)
                    if lastV + rate * d + rate * (0.5 * stepE - offs) >= pc then fire = true end
                end
            elseif el > 0.15 and hn == 0 then
                mode = "TIME*"
            end
            if not fire and el >= aim / 1000 + 0.08 then
                fire = true
                mode = "METER!"
            end
        end
        if not fire and mode ~= "METER" and mode ~= "METER!" then
            if tgt - n <= loopStep * 0.5 then fire = true end
        end
        if fire then
            local tRel = now()
            release(vk)
            sh.actual = (tRel - t0) * 1000
            sh.tRel = tRel
            sh.loopStep = loopStep
            if lockC and #hist >= 3 then
                local rate, dEst = rateOf(hist)
                if rate and rate > 0 then
                    sh.px = lastV + rate * (BAR.gdt or dEst)
                    sh.prate = rate
                end
            end
            break
        end
        if keyDown(vk) then
            ups = 0
        else
            ups = ups + 1
            if ups >= 2 then
                sh.manual = true
                break
            end
        end
        if el > 2.5 then break end
        local w0 = now()
        if fine then task.wait(0.002) else task.wait() end
        local dw = now() - w0
        if dw > 0 and dw < 0.25 then
            loopStep = loopStep + (dw - loopStep) * 0.25
            if not fine then ST.step = ST.step + (dw - ST.step) * 0.2 end
        end
    end
    sh.mode = mode
    sh.hist = hist
    sh.cands = cands
    sh.fine = fine
    ST.busy = false
    pauseUI(false)
    if not alive then return end
    task.spawn(function()
        local res, cov = waitResult()
        if not alive then return end
        local ok, err = pcall(processResult, sh, res, cov)
        if not ok then print("[BASKETBALL] result error: " .. tostring(err)) end
    end)
end

local function waitRearm(vk)
    local relT = nil
    while alive do
        if keyDown(vk) then
            relT = nil
        else
            relT = relT or now()
            if now() - relT >= 0.15 then return end
        end
        task.wait()
    end
end

