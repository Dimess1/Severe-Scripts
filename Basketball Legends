local function scanHoops()
    local root = Workspace
    local okg, g = pcall(rdFind, Workspace, "Game")
    if okg and g then
        local okc, c = pcall(rdFind, g, "Courts")
        if okc and c then root = c end
    end
    local ok, list = pcall(rdDesc, root)
    ST.scanT = now()
    ST.needScan = false
    if not ok or type(list) ~= "table" then return end
    local found = {}
    for i, obj in ipairs(list) do
        if i % 3000 == 0 then
            task.wait()
            if not alive then return end
        end
        local okn, nm = pcall(rdName, obj)
        if okn and nm then
            nm = string.lower(tostring(nm))
            if (string.find(nm, "rim", 1, true) or string.find(nm, "hoop", 1, true)) and isPart(obj) then
                local okp, pos = pcall(rdPosition, obj)
                if okp and pos then
                    local dup = false
                    for _, e in ipairs(found) do
                        if hdist(pos, e) < 6 then dup = true break end
                    end
                    if not dup then found[#found + 1] = pos end
                end
            end
        end
    end
    if #found > 0 or #hoops == 0 then
        hoops = found
        ST.hoops = #found
    end
end

local function getTarget(root)
    if #hoops == 0 then
        scanHoops()
        if #hoops == 0 then return nil end
    end
    local okp, rp = pcall(rdPosition, root)
    if not okp or not rp then return nil end
    local okl, look = pcall(rdLook, root)
    if not okl then look = nil end
    local nearest, nearD = nil, math.huge
    local best, bestS, bestDot = nil, math.huge, nil
    for _, h in ipairs(hoops) do
        local dx, dz = h.X - rp.X, h.Z - rp.Z
        local d = math.sqrt(dx * dx + dz * dz)
        if d < nearD then nearest, nearD = h, d end
        if look and d > 0.01 then
            local dot = look.X * (dx / d) + look.Z * (dz / d)
            if dot > 0.10 then
                local s = d + (1 - dot) * 12
                if s < bestS then best, bestS, bestDot = h, s, dot end
            end
        end
    end
    if nearD > 150 then ST.needScan = true end
    if best then return best, hdist(rp, best), bestDot, rp end
    return nearest, nearD, nil, rp
end

local function getMovement(root, hoop, rp)
    local v = getVelocity(root)
    if not v then return { speed = 0, radial = 0, lateral = 0, yvel = 0 } end
    local dx, dz = hoop.X - rp.X, hoop.Z - rp.Z
    local d = math.sqrt(dx * dx + dz * dz)
    if d < 0.01 then return { speed = 0, radial = 0, lateral = 0, yvel = round1(v.Y) } end
    local ux, uz = dx / d, dz / d
    return {
        speed = round1(math.sqrt(v.X * v.X + v.Z * v.Z)),
        radial = round1(v.X * ux + v.Z * uz),
        lateral = round1(v.X * -uz + v.Z * ux),
        yvel = round1(v.Y)
    }
end

local function getPing()
    local ok, v = pcall(GetPingValue)
    if ok and v ~= nil then
        local n = tonumber(v)
        if n and n >= 0 and n < 5000 then return round1(n) end
    end
    return nil
end

local function features(mv, ping)
    if not C.comp then return 0, 0, 0 end
    local xp = 0
    if ping and M.pavg then xp = clamp((ping - M.pavg) / 50, -3, 3) end
    local xr = clamp(mv.radial / 20, -2, 2)
    local xl = clamp(math.abs(mv.lateral) / 20, 0, 2)
    return xp, xr, xl
end

local function bucketOf(d)
    local x = clamp(d, B_MIN, B_MAX)
    local a = math.floor(x)
    if a >= B_MAX then return B_MAX, B_MAX, 0 end
    return a, a + 1, x - a
end

local function baseTime(d, xp, xr, xl)
    local a, b, f = bucketOf(d)
    local base = PROFILE[a] + (PROFILE[b] - PROFILE[a]) * f
    local comp = 0
    if C.comp then comp = M.kp * xp + M.kr * xr + M.kl * xl end
    return base + comp, a, b, f
end

local function timeCenter()
    if M.g ~= nil then return M.g end
    return ST.bias + (M.gPrior or 0)
end

local function timeSafe()
    return (ST.fine and 1 or ST.step * 500) + 3
end

local TCC = { ver = -1, map = {} }

local function timeCenterAt(d)
    local g = timeCenter() + (ST.explore or 0)
    if #TS == 0 then return g end
    if TCC.ver ~= ST.tsVer then
        TCC.ver = ST.tsVer
        TCC.map = {}
    end
    local key = math.floor(d * 2 + 0.5)
    local hit = TCC.map[key]
    if hit then return hit end
    local c, np, _, lb, ub, _, _, wsum = bracket(TS, timeSafe(), 4, d, 4)
    if c == nil then
        local res = g
        if lb and lb > g - 6 then res = lb + 8 elseif ub and ub < g + 6 then res = ub - 8 end
        TCC.map[key] = res
        return res
    end
    local k = clamp((wsum or 0) / 6, 0, 1)
    local res = g + (c - g) * k
    TCC.map[key] = res
    return res
end

local function compLearn(sh, dir)
    if not C.comp then return end
    local g = 3 * dir / (1 + sh.xp * sh.xp + sh.xr * sh.xr + sh.xl * sh.xl)
    M.kp = clamp(M.kp + g * sh.xp * 0.5, -15, 15)
    M.kr = clamp(M.kr + g * sh.xr * 0.5, -15, 15)
    M.kl = clamp(M.kl + g * sh.xl * 0.5, -15, 15)
end

local EXPLORE = { -0.5, 0.5, -1, 1, -1.5, 1.5 }

local function learnTime(sh, cls)
    pushSample(TS, sh.r, cls, CAP_TIME, sh.dist)
    ST.tsVer = (ST.tsVer or 0) + 1
    local anyP = false
    for _, s in ipairs(TS) do if s.c == "P" then anyP = true break end end
    if anyP or cls == "E" or cls == "L" then
        ST.explore, ST.exploreN = 0, 0
    elseif cls == "N" then
        ST.exploreN = (ST.exploreN or 0) + 1
        ST.explore = EXPLORE[((ST.exploreN - 1) % #EXPLORE) + 1] * ST.step * 1000
    end
    local c, _, _, lb, ub = bracket(TS, timeSafe(), 4)
    if c then
        if M.g == nil then M.g = c else M.g = M.g + (c - M.g) * 0.5 end
        M.g = clamp(M.g, -80, 140)
    else
        local g = timeCenter()
        if lb and lb > g - 6 then g = lb + 8 end
        if ub and ub < g + 6 then g = ub - 8 end
        M.g = clamp(g, -80, 140)
    end
    if math.abs(sh.extra) <= 8 then
        if cls == "E" then compLearn(sh, 1) elseif cls == "L" then compLearn(sh, -1) end
    end
end

local function learnMeter(px, rate, cls)
    pushSample(BAR.S, px, cls, CAP_BAR)
    local r = rate or 2.7
    local g = BAR.gdt or ST.step
    local stepE = ST.fine and g or math.max(ST.step, g)
    local c, _, _, lb, ub = bracket(BAR.S, r * (0.5 * stepE + 0.002), r * 0.0012)
    if c then
        if BAR.Pc == nil then BAR.Pc = c else BAR.Pc = BAR.Pc + (c - BAR.Pc) * 0.5 end
    elseif BAR.Pc then
        local m = math.max(0.015, (rate or 2.7) * 0.007)
        if lb and lb > BAR.Pc - m then BAR.Pc = lb + m end
        if ub and ub < BAR.Pc + m then BAR.Pc = ub - m end
    end
end

local function meterPerfects()
    local n, lo, hi = 0, math.huge, -math.huge
    for _, s in ipairs(BAR.S) do
        if s.c == "P" then
            n = n + 1
            if s.x < lo then lo = s.x end
            if s.x > hi then hi = s.x end
        end
    end
    if n == 0 then return 0, 0 end
    return n, hi - lo
end

local function barReady()
    if not BAR.path or BAR.lock < 2 or BAR.Pc == nil then return false end
    local n, spread = meterPerfects()
    return n >= 2 and spread <= 0.08
end

