local function pct(a, b)
    if b <= 0 then return "0%" end
    return string.format("%.0f%%", a / b * 100)
end

local function meterStatus()
    if C.mode == 1 then return "off (timing only)" end
    if not BAR.path then return "searching" end
    if barReady() then return string.format("ACTIVE  Pc=%.3f", BAR.Pc) end
    local n = meterPerfects()
    return string.format("learning  lock %d/2  perf %d/2", BAR.lock, n)
end

local function toast(msg, dur, kind)
    if Lib and C.notif then pcall(function() Lib:Notify(msg, "Basketball", dur or 2.5, kind) end) end
end

local function applyAccent(name)
    if not QuantomLib then return false end
    for _, a in ipairs(ACCENTS) do
        if a[1] == name then
            local c = Color3.fromRGB(a[2], a[3], a[4])
            local d = Color3.fromRGB(math.floor(a[2] * 0.6), math.floor(a[3] * 0.6), math.floor(a[4] * 0.6))
            QuantomLib:SetTheme({ accent = c, tab_text_active = c, toggle_on = c, slider_fill = c, accent_dark = d })
            return true
        end
    end
    return false
end

