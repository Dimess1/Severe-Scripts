local function loadData()
    local okf, isf = pcall(isfile, DATA_FILE)
    if okf and isf == false then return false end
    local ok, raw = pcall(readfile, DATA_FILE)
    if not ok or type(raw) ~= "string" or raw == "" then return false end
    local ok2, d = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok2 or type(d) ~= "table" then return false end
    local ver = num(d.v, 3)
    local c = type(d.cfg) == "table" and d.cfg or {}
    for _, k in ipairs({ "on", "learn", "comp", "log", "wm", "notif", "gradeLearn", "pauseUi" }) do
        if type(c[k]) == "boolean" then C[k] = c[k] end
    end
    for _, k in ipairs({ "keyName", "accent", "menuKey", "toggleKey" }) do
        if type(c[k]) == "string" and c[k] ~= "" then C[k] = c[k] end
    end
    if inList(c.target, GRADES) then C.target = c.target end
    if inList(c.missGrade, MISS_OPTS) then C.missGrade = c.missGrade end
    if inList(c.side, SIDE_OPTS) then C.side = c.side end
    C.wx = num(c.wx, C.wx)
    C.wy = num(c.wy, C.wy)
    C.mode = clamp(math.floor(num(c.mode, C.mode)), 0, 1)
    C.off = clamp(math.floor(num(c.off, C.off)), -30, 30)
    C.chance = clamp(math.floor(num(c.chance, C.chance)), 0, 100)
    C.jitter = clamp(math.floor(num(c.jitter, C.jitter)), 0, 30)
    C.maxStreak = clamp(math.floor(num(c.maxStreak, C.maxStreak)), 0, 30)
    C.minDist = clamp(math.floor(num(c.minDist, C.minDist)), 0, 100)
    C.maxDist = clamp(math.floor(num(c.maxDist, C.maxDist)), 0, 100)
    if type(d.grades) == "table" and type(d.grades.e) == "table" and type(d.grades.l) == "table" then
        for i = 2, 6 do
            GDE[i] = clamp(num(d.grades.e[i], GDE[i]), 2, 150)
            GDL[i] = clamp(num(d.grades.l[i], GDL[i]), 2, 150)
        end
    end
    local m = type(d.model) == "table" and d.model or {}
    M.kp = clamp(num(m.kp, 0), -15, 15)
    M.kr = clamp(num(m.kr, 0), -15, 15)
    M.kl = clamp(num(m.kl, 0), -15, 15)
    local pa = num(m.pavg, -1)
    if pa >= 0 then M.pavg = pa end
    if ver >= 4 then
        local g = num(m.g, -999)
        if g > -900 then M.g = g end
        local gp = num(m.gPrior, -999)
        if gp > -900 then M.gPrior = gp end
        decSamples(m.ts, TS, CAP_TIME)
    else
        M.gPrior = num(m.g, 0)
    end
    local br = type(d.bar) == "table" and d.bar or {}
    if type(br.path) == "table" and #br.path > 0 then
        local p = {}
        for i, s in ipairs(br.path) do p[i] = tostring(s) end
        BAR.path = p
        BAR.ch = clamp(math.floor(num(br.ch, 0)), 0, 4)
        BAR.sgn = num(br.sgn, 1) < 0 and -1 or 1
        BAR.lock = clamp(math.floor(num(br.lock, 0)), 0, 5)
        if ver >= 4 and num(br.xs, 0) == 2 then
            decSamples(br.S, BAR.S, CAP_BAR)
            local pc = num(br.Pc, -999)
            if pc > -900 then BAR.Pc = pc end
            local dt = num(br.gdt, -1)
            if dt > 0 then BAR.gdt = dt end
            if type(br.fine) == "boolean" then BAR.fine = br.fine end
        end
        if BAR.ch == 0 then BAR.path = nil BAR.lock = 0 end
    end
    local s = type(d.stats) == "table" and d.stats or {}
    for _, k in ipairs({ "shots", "perfect", "good", "early", "late", "miss", "hits", "attempts", "great", "goodOnly", "skipped" }) do
        ST[k] = math.max(0, math.floor(num(s[k], 0)))
    end
    return true
end

