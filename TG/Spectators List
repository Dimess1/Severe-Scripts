    border = Color3.fromRGB(45, 40, 65),
    title = Color3.fromRGB(235, 230, 255),
    countBg = Color3.fromRGB(140, 110, 255),
    countText = Color3.fromRGB(255, 255, 255),
    name = Color3.fromRGB(190, 185, 210),
    dot = Color3.fromRGB(100, 220, 160),
    separator = Color3.fromRGB(35, 32, 50),
    empty = Color3.fromRGB(75, 70, 95),
    footer = Color3.fromRGB(160, 150, 200),
    shadow = Color3.fromRGB(5, 5, 8),
}

local allDrawings = {}

local function create(class, props)
    local obj = Drawing.new(class)
    for k, v in props do
        obj[k] = v
    end
    allDrawings[#allDrawings + 1] = obj
    return obj
end

