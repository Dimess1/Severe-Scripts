    if cfg.autoSize ~= nil then self.autoSize = cfg.autoSize and true or false else self.autoSize = cfg.height == nil end
    self.visible = cfg.visible ~= false
    self.toggleKey = cfg.toggleKey ~= nil and _normKey(cfg.toggleKey) or "Insert"
    self.tabs = {}
    self.activeTab = nil
    self.dragging = false
    self.dragOX, self.dragOY = 0, 0
    self.H = self.height
