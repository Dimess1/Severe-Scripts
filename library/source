function QuantomLib:Notify(text, title, duration)
    local n = { text = tostring(text or ""), title = tostring(title or "Quantom"), dur = tonumber(duration) or 3, t0 = tick(), _all = {}, y = nil }
    n._bg = _new(n._all, "Square", { Filled = true, Color = Theme.notify_bg, Rounding = 4, ZIndex = S.zTop + 20 })
    n._border = _new(n._all, "Square", { Filled = false, Thickness = 1, Color = Theme.section_border, Rounding = 4, ZIndex = S.zTop + 21 })
    n._bar = _new(n._all, "Square", { Filled = true, Color = Theme.accent, ZIndex = S.zTop + 22 })
    n._prog = _new(n._all, "Square", { Filled = true, Color = Theme.accent, ZIndex = S.zTop + 22 })
    n._title = _new(n._all, "Text", { Color = Theme.accent, TextSize = 13, ZIndex = S.zTop + 23 })
    n._text = _new(n._all, "Text", { Color = Theme.text, TextSize = 12, ZIndex = S.zTop + 23 })
    S.notifs[#S.notifs + 1] = n
    while #S.notifs > 6 do
        local old = table.remove(S.notifs, 1)
        for _, w in ipairs(old._all) do _kill(w) end
    end
    return n
end

function QuantomLib:Watermark(text)
    if S.wm then
        S.wm.text = tostring(text or "")
        S.wm.visible = true
        return S.wm
    end
    local wm = { text = tostring(text or "quantom.gg"), visible = true, _all = {} }
    wm._bg = _new(wm._all, "Square", { Filled = true, Color = Theme.bg, Opacity = 0.95, Rounding = 4, ZIndex = S.zTop + 10 })
    wm._border = _new(wm._all, "Square", { Filled = false, Thickness = 1, Color = Theme.section_border, Rounding = 4, ZIndex = S.zTop + 11 })
    wm._bar = _new(wm._all, "Square", { Filled = true, Color = Theme.accent, ZIndex = S.zTop + 12 })
    wm._text = _new(wm._all, "Text", { Color = Theme.text, TextSize = 13, ZIndex = S.zTop + 12 })
    function wm:Set(t) self.text = tostring(t) return self end
    function wm:SetVisible(b) self.visible = b and true or false return self end
    S.wm = wm
    return wm
end

function QuantomLib:SaveConfig(name)
    if not HttpService then return false end
    local data = {}
    for flag, el in pairs(S.flagEls) do
        data[flag] = el.value
        if el.type == "toggle" and el.keybind then data[flag .. "__key"] = el.keybind end
    end
    local ok, s = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok or type(s) ~= "string" then return false end
    pcall(makefolder, "QuantomLib")
    local ok2 = pcall(writefile, "QuantomLib/" .. tostring(name or "default") .. ".json", s)
    return ok2
end

function QuantomLib:LoadConfig(name)
    if not HttpService then return false end
    local ok, raw = pcall(readfile, "QuantomLib/" .. tostring(name or "default") .. ".json")
    if not ok or type(raw) ~= "string" then return false end
    local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok2 or type(data) ~= "table" then return false end
    for flag, el in pairs(S.flagEls) do
        if data[flag] ~= nil then el:Set(data[flag]) end
        if el.type == "toggle" and data[flag .. "__key"] ~= nil then el.keybind = _normKey(data[flag .. "__key"]) end
    end
    return true
end

function QuantomLib:ListConfigs()
    local out = {}
    local ok, files = pcall(listfiles, "QuantomLib")
    if ok and type(files) == "table" then
        for _, f in ipairs(files) do
            local n = string.match(tostring(f), "([^/\\]+)%.json$")
            if n then out[#out + 1] = n end
        end
    end
    return out
end

function QuantomLib:Destroy()
    S.alive = false
    for _, c in ipairs(S.conns) do pcall(function() c:Disconnect() end) end
    S.conns = {}
    for _, w in ipairs(S.drawings) do _kill(w) end
    S.drawings, S.windows, S.notifs = {}, {}, {}
    S.dropdown, S.listening, S.slider, S.dragWin, S.wm = nil, nil, nil, nil, nil
end

local function _applyBind(L, v)
    local el = L.el
    if L.field == "keybind" then
        el.keybind = v
        if el.keybindCallback then pcall(el.keybindCallback, v) end
    else
        el:Set(v)
    end
end

local function _keys(active)
    if S.listening then
        if S.listenArm then
            local any = M.down
            if not any then
                for _, n in ipairs(VK_ORDER) do
                    if _kd(VK[n]) then any = true break end
                end
            end
            if not any then S.listenArm = false end
        else
            for _, n in ipairs(VK_ORDER) do
                if _kd(VK[n]) then
                    local v = n
                    if n == "Escape" or n == "Backspace" then v = "Unbound" end
                    S.kprev[n] = true
                    local L = S.listening
                    S.listening = nil
                    _applyBind(L, v)
                    break
                end
            end
        end
        return
    end
    local used = {}
    for _, w in ipairs(S.windows) do
        if VK[w.toggleKey or ""] then used[w.toggleKey] = true end
        for _, tab in ipairs(w.tabs) do
            for _, sec in ipairs(tab.sections) do
                for _, el in ipairs(sec.elements) do
                    if el.type == "toggle" and el.keybind and VK[el.keybind] then used[el.keybind] = true
                    elseif el.type == "keybind" and VK[el.value] then used[el.value] = true end
                end
            end
        end
    end
    local now = {}
    for n in pairs(used) do now[n] = active and _kd(VK[n]) or false end
    local prev = S.kprev
    S.kprev = now
    S.kdown = now
    local function edge(n) return n ~= nil and now[n] == true and prev[n] ~= true end
    for _, w in ipairs(S.windows) do
        if edge(w.toggleKey) then
            w.visible = not w.visible
            if not w.visible then _closeDD() end
        end
        for _, tab in ipairs(w.tabs) do
            for _, sec in ipairs(tab.sections) do
                for _, el in ipairs(sec.elements) do
                    if el.type == "toggle" and el.keybind and edge(el.keybind) then
                        el:Set(not el.value)
                    elseif el.type == "keybind" and el.pressed and edge(el.value) then
                        local ok, e = pcall(el.pressed, el.value)
                        if not ok then print("[QuantomLib] keybind error: " .. tostring(e)) end
                    end
                end
            end
        end
    end
end

local function _layout(w)
    local x, y, W = w.x, w.y, w.width
    local tab = w.activeTab
    local cX, cY = x + 8, y + 67
    local hW = math.floor((W - 16) / 2) - 4
    local lY, rY = cY, cY
    for _, t in ipairs(w.tabs) do
        if t ~= tab then
            for _, sec in ipairs(t.sections) do
                sec.rx = nil
                for _, el in ipairs(sec.elements) do el.rx = nil end
            end
        end
    end
    if tab then
        for _, sec in ipairs(tab.sections) do
            local isL = sec.side ~= "right"
            local sX = isL and cX or (cX + hW + 8)
            local sY = isL and lY or rY
            local h = 28
            for _, el in ipairs(sec.elements) do
                if el.visible then h = h + _h(el) end
            end
            h = h + 6
            sec.rx, sec.ry, sec.rw, sec.rh = sX, sY, hW, h
            local eY = sY + 28
            for _, el in ipairs(sec.elements) do
                if el.visible then
                    el.rx, el.ry, el.rw, el.rh = sX + 8, eY, hW - 16, _h(el)
                    eY = eY + el.rh
                else
                    el.rx = nil
                end
            end
            if isL then lY = lY + h + 6 else rY = rY + h + 6 end
        end
    end
    if w.autoSize then
        w.H = math.max(w.minHeight, math.max(lY, rY) - y + 2)
    else
        w.H = w.height
    end
end

local function _slideTo(el)
    local p = _clamp((M.x - el.rx) / math.max(el.rw, 1), 0, 1)
    el:Set(el.min + p * (el.max - el.min))
end

local function _elClick(el)
    local t = el.type
    if t == "toggle" then
        local kbX = el.rx + el.rw - 34 - (el.kbW or 0)
        if el.keybind and M.x >= kbX - 4 and M.x <= el.rx + el.rw - 32 then
            S.listening = { el = el, field = "keybind" }
            S.listenArm = true
        else
            el:Set(not el.value)
        end
    elseif t == "slider" then
        if M.y >= el.ry + 12 then
            S.slider = el
            _slideTo(el)
        end
    elseif t == "dropdown" then
        if M.y >= el.ry + 15 then
            if el.open then
                _closeDD()
            else
                _closeDD()
                el.open = true
                S.dropdown = el
            end
        end
    elseif t == "keybind" then
        S.listening = { el = el, field = "value" }
        S.listenArm = true
    elseif t == "button" then
        el.flash = 1
        _fire(el)
    end
end

local function _windowClick(w)
    if M.y <= w.y + 30 then
        S.dragWin = w
        w.dragging = true
        w.dragOX, w.dragOY = M.x - w.x, M.y - w.y
        return
    end
    if M.y <= w.y + 59 then
        local n = #w.tabs
        if n == 0 then return end
        local i = _clamp(math.floor((M.x - w.x) / (w.width / n)) + 1, 1, n)
        if w.tabs[i] ~= w.activeTab then
            w.activeTab = w.tabs[i]
            _closeDD()
        end
        return
    end
    local tab = w.activeTab
    if not tab then return end
    for _, sec in ipairs(tab.sections) do
        if sec.rx and _hit(sec.rx, sec.ry, sec.rw, sec.rh) then
            for _, el in ipairs(sec.elements) do
                if el.rx and _hit(el.rx, el.ry, el.rw, el.rh) then
                    _elClick(el)
                    return
                end
            end
            return
        end
    end
end

local function _input()
    if S.dragWin then
        local w = S.dragWin
        if M.down then
            w.x = _clamp(M.x - w.dragOX, 0, math.max(0, S.vw - w.width))
            w.y = _clamp(M.y - w.dragOY, 0, math.max(0, S.vh - 30))
        else
            w.dragging = false
            S.dragWin = nil
        end
    end
    if S.slider then
        if M.down and S.slider.rx then _slideTo(S.slider) else S.slider = nil end
    end
    if not M.click then return end
    if S.listening then
        S.listening = nil
        M.click = false
        return
    end
    local dd = S.dropdown
    if dd then
        if dd.rx and dd.window.visible then
            local oy = dd.ry + 39
            for i = 1, #dd.options do
                if _hit(dd.rx, oy + (i - 1) * 22, dd.rw, 22) then
                    _closeDD()
                    dd:Set(dd.options[i])
                    M.click = false
                    return
                end
            end
            if not _hit(dd.rx, dd.ry + 15, dd.rw, 24) then
                _closeDD()
                M.click = false
                return
            end
        else
            _closeDD()
        end
    end
    for i = #S.windows, 1, -1 do
        local w = S.windows[i]
        if w.visible and _hit(w.x, w.y, w.width, w.H) then
            _windowClick(w)
            M.click = false
            return
        end
    end
end

local function _drawEl(el, on, dt)
    if not on or not el.rx then
        _hideAll(el._all)
        if el._ovAll then _hideAll(el._ovAll) end
        if el._opts then for _, o in ipairs(el._opts) do _vis(o.bg, false) _vis(o.text, false) end end
        return
    end
    local x, y, w = el.rx, el.ry, el.rw
    local hov = _hit(x, y, w, el.rh) and S.dropdown == nil and S.dragWin == nil
    local t = el.type
    if t == "toggle" then
        el.anim = el.anim + ((el.value and 1 or 0) - el.anim) * _clamp(dt * 14, 0, 1)
        local tx, ty = x + w - 26, y + 5
        _set(el._text, "Text", el.name)
        _set(el._text, "Color", (hov or el.value) and Theme.text_hover or Theme.text)
        _pos(el._text, x, y + 4)
        _vis(el._text, true)
        _set(el._track, "Color", el.anim > 0.5 and Theme.toggle_on or Theme.toggle_off)
        _pos(el._track, tx, ty)
        _size(el._track, 26, 12)
        _vis(el._track, true)
        _pos(el._knob, tx + 2 + el.anim * 14, ty + 2)
        _size(el._knob, 8, 8)
        _vis(el._knob, true)
        if el.keybind then
            local listening = S.listening and S.listening.el == el and S.listening.field == "keybind"
            local s = listening and "[...]" or ("[" .. el.keybind .. "]")
            _set(el._kb, "Text", s)
            _set(el._kb, "Color", listening and Theme.accent or Theme.text_dim)
            local kw = _tw(el._kb, s, 12)
            el.kbW = kw
            _pos(el._kb, tx - 6 - kw, y + 5)
            _vis(el._kb, true)
        else
            _vis(el._kb, false)
        end
    elseif t == "slider" then
        local vs = string.format("%." .. el.decimals .. "f", el.value) .. el.suffix
        _set(el._text, "Text", el.name)
        _set(el._text, "Color", (hov or S.slider == el) and Theme.text_hover or Theme.text)
        _pos(el._text, x, y + 2)
        _vis(el._text, true)
        _set(el._val, "Text", vs)
        _pos(el._val, x + w - _tw(el._val, vs, 13), y + 2)
        _vis(el._val, true)
        local pct = (el.value - el.min) / (el.max - el.min)
        _pos(el._bg, x, y + 21)
        _size(el._bg, w, 5)
        _vis(el._bg, true)
        _pos(el._fill, x, y + 21)
        _size(el._fill, math.max(2, w * pct), 5)
        _vis(el._fill, true)
        _set(el._knob, "Color", (hov or S.slider == el) and Theme.accent or Theme.knob)
        _pos(el._knob, x + w * pct - 5, y + 18)
        _size(el._knob, 10, 10)
        _vis(el._knob, true)
    elseif t == "dropdown" then
        _set(el._label, "Text", el.name)
        _pos(el._label, x, y + 1)
        _vis(el._label, true)
        _pos(el._bg, x, y + 17)
        _size(el._bg, w, 22)
        _set(el._bg, "Color", (hov or el.open) and Theme.dropdown_hover or Theme.dropdown_bg)
        _vis(el._bg, true)
        _pos(el._border, x, y + 17)
        _size(el._border, w, 22)
        _set(el._border, "Color", el.open and Theme.accent_dark or Theme.section_border)
        _vis(el._border, true)
        _set(el._val, "Text", el.value)
        _pos(el._val, x + 7, y + 21)
        _vis(el._val, true)
        _set(el._arrow, "Text", el.open and "^" or "v")
        _pos(el._arrow, x + w - 14, y + 21)
        _vis(el._arrow, true)
        for i = #el._opts + 1, #el.options do
            el._opts[i] = {
                bg = _new(el._ovAll, "Square", { Filled = true, Color = Theme.dropdown_item, ZIndex = S.zTop }),
                text = _new(el._ovAll, "Text", { Color = Theme.text, ZIndex = S.zTop + 1 })
            }
        end
        local oy = y + 39
        for i, o in ipairs(el._opts) do
            local opt = el.options[i]
            local sv = el.open and opt ~= nil
            if sv then
                local ry = oy + (i - 1) * 22
                local oh = _hit(x, ry, w, 22)
                _pos(o.bg, x, ry)
                _size(o.bg, w, 22)
                _set(o.bg, "Color", oh and Theme.dropdown_hover or Theme.dropdown_item)
                _set(o.text, "Text", opt)
                _set(o.text, "Color", opt == el.value and Theme.accent or (oh and Theme.text_hover or Theme.text))
                _pos(o.text, x + 7, ry + 4)
            end
            _vis(o.bg, sv)
            _vis(o.text, sv)
        end
        if el.open and #el.options > 0 then
            _pos(el._ovBorder, x, oy)
            _size(el._ovBorder, w, #el.options * 22)
            _vis(el._ovBorder, true)
        else
            _vis(el._ovBorder, false)
        end
    elseif t == "keybind" then
        local listening = S.listening and S.listening.el == el and S.listening.field == "value"
        local s = listening and "..." or el.value
        _set(el._text, "Text", el.name)
        _set(el._text, "Color", hov and Theme.text_hover or Theme.text)
        _pos(el._text, x, y + 4)
        _vis(el._text, true)
        _set(el._val, "Text", s)
        _set(el._val, "Color", listening and Theme.accent or Theme.text_dim)
        local kw = math.max(56, _tw(el._val, s, 12) + 16)
        _pos(el._bg, x + w - kw, y + 2)
        _size(el._bg, kw, 18)
        _set(el._bg, "Color", (hov or listening) and Theme.dropdown_hover or Theme.keybind_bg)
        _vis(el._bg, true)
        _pos(el._val, x + w - kw / 2, y + 4)
        _vis(el._val, true)
    elseif t == "button" then
        el.flash = math.max(0, el.flash - dt * 4)
        _pos(el._bg, x, y + 2)
        _size(el._bg, w, 22)
        _set(el._bg, "Color", el.flash > 0.05 and Theme.accent_dark or (hov and Theme.button_hover or Theme.button_bg))
        _vis(el._bg, true)
        _pos(el._border, x, y + 2)
        _size(el._border, w, 22)
        _set(el._border, "Color", hov and Theme.accent_dark or Theme.section_border)
        _vis(el._border, true)
        _set(el._text, "Text", el.name)
        _set(el._text, "Color", hov and Theme.text_hover or Theme.text)
        _pos(el._text, x + w / 2, y + 6)
        _vis(el._text, true)
    elseif t == "separator" then
        _pos(el._line, x, y + 5)
        _size(el._line, w, 1)
        _vis(el._line, true)
    elseif t == "label" then
        _set(el._text, "Text", el.text)
        _set(el._text, "Color", el.color or Theme.text_dim)
        _pos(el._text, x, y + 2)
        _vis(el._text, true)
    end
end

local function _drawWin(w, dt)
    local vis = w.visible
    local x, y, W, H = w.x, w.y, w.width, w.H
    _pos(w._shadow, x - 2, y - 2) _size(w._shadow, W + 4, H + 4) _vis(w._shadow, vis)
    _set(w._bg, "Color", Theme.bg)
    _pos(w._bg, x, y) _size(w._bg, W, H) _vis(w._bg, vis)
    _pos(w._border, x, y) _size(w._border, W, H) _vis(w._border, vis)
    _pos(w._titlebar, x, y) _size(w._titlebar, W, 30) _vis(w._titlebar, vis)
    _pos(w._titlefix, x, y + 20) _size(w._titlefix, W, 10) _vis(w._titlefix, vis)
    _set(w._title, "Text", w.title)
    _set(w._title, "Color", Theme.accent)
    _pos(w._title, x + 10, y + 8) _vis(w._title, vis)
    if w.subtitle then
        _set(w._sub, "Text", w.subtitle)
        _pos(w._sub, x + 16 + _tw(w._title, w.title, 14), y + 9)
        _vis(w._sub, vis)
    else
        _vis(w._sub, false)
    end
    _set(w._accent, "Color", Theme.accent)
    _pos(w._accent, x, y + 30) _size(w._accent, W, 1) _vis(w._accent, vis)
    _pos(w._tabbar, x, y + 31) _size(w._tabbar, W, 28) _vis(w._tabbar, vis)
    local n = math.max(#w.tabs, 1)
    local tW = W / n
    for i, tab in ipairs(w.tabs) do
        local tx = x + (i - 1) * tW
        local act = tab == w.activeTab
        local hov = vis and _hit(tx, y + 31, tW, 28)
        _pos(tab._bg, tx, y + 31) _size(tab._bg, tW, 28)
        _set(tab._bg, "Opacity", act and 1 or (hov and 0.5 or 0))
        _vis(tab._bg, vis)
        _set(tab._text, "Text", tab.name)
        _set(tab._text, "Color", act and Theme.tab_text_active or (hov and Theme.text or Theme.tab_text))
        _pos(tab._text, tx + tW / 2, y + 38)
        _vis(tab._text, vis)
        if act then
            local target = tx + 6
            if not w.lineX then w.lineX = target end
            w.lineX = w.lineX + (target - w.lineX) * _clamp(dt * 16, 0, 1)
        end
        for _, sec in ipairs(tab.sections) do
            local on = vis and act and sec.rx ~= nil
            if on then
                _pos(sec._bg, sec.rx, sec.ry) _size(sec._bg, sec.rw, sec.rh) _vis(sec._bg, true)
                _pos(sec._border, sec.rx, sec.ry) _size(sec._border, sec.rw, sec.rh) _vis(sec._border, true)
                _set(sec._title, "Text", sec.name)
                _pos(sec._title, sec.rx + 8, sec.ry + 6) _vis(sec._title, true)
                _set(sec._line, "Color", Theme.accent)
                _pos(sec._line, sec.rx + 8, sec.ry + 23) _size(sec._line, 18, 1) _vis(sec._line, true)
            else
                _hideAll(sec._all)
            end
            for _, el in ipairs(sec.elements) do _drawEl(el, on and el.visible, dt) end
        end
    end
    if w.lineX and #w.tabs > 0 then
        _set(w._tabline, "Color", Theme.accent)
        _pos(w._tabline, w.lineX, y + 57) _size(w._tabline, tW - 12, 2)
        _vis(w._tabline, vis)
    else
        _vis(w._tabline, false)
    end
end

local function _drawNotifs(now)
    local by = S.vh - 14
    local i = #S.notifs
    while i >= 1 do
        local n = S.notifs[i]
        local age = now - n.t0
        if age >= n.dur + 0.3 then
            for _, w in ipairs(n._all) do _kill(w) end
            table.remove(S.notifs, i)
        else
            local a = _clamp(math.min(age / 0.2, (n.dur + 0.3 - age) / 0.3), 0, 1)
            local nw = math.max(220, math.min(380, #n.text * 6.6 + 30))
            local nh = 46
            local ty = by - nh
            if n.y == nil then n.y = ty end
            n.y = n.y + (ty - n.y) * 0.25
            local nx = S.vw - 14 - nw + (1 - a) * 40
            _pos(n._bg, nx, n.y) _size(n._bg, nw, nh) _set(n._bg, "Opacity", 0.96 * a) _vis(n._bg, true)
            _pos(n._border, nx, n.y) _size(n._border, nw, nh) _set(n._border, "Opacity", a) _vis(n._border, true)
            _pos(n._bar, nx, n.y + 4) _size(n._bar, 2, nh - 8) _set(n._bar, "Opacity", a) _vis(n._bar, true)
            local p = _clamp(1 - age / n.dur, 0, 1)
            _pos(n._prog, nx + 4, n.y + nh - 3) _size(n._prog, (nw - 8) * p, 2) _set(n._prog, "Opacity", 0.7 * a) _vis(n._prog, true)
            _set(n._title, "Text", n.title) _pos(n._title, nx + 12, n.y + 7) _set(n._title, "Opacity", a) _vis(n._title, true)
            _set(n._text, "Text", n.text) _pos(n._text, nx + 12, n.y + 25) _set(n._text, "Opacity", a) _vis(n._text, true)
            by = n.y - 8
        end
        i = i - 1
    end
end

local function _drawWatermark()
    local wm = S.wm
    if not wm then return end
    if not wm.visible then
        _hideAll(wm._all)
        return
    end
    local s = wm.text
    s = string.gsub(s, "{fps}", tostring(math.floor(S.fps + 0.5)))
    local tw = _tw(wm._text, s, 13)
    _set(wm._text, "Text", s)
    local w = tw + 20
    _pos(wm._bg, 12, 12) _size(wm._bg, w, 24) _vis(wm._bg, true)
    _pos(wm._border, 12, 12) _size(wm._border, w, 24) _vis(wm._border, true)
    _set(wm._bar, "Color", Theme.accent)
    _pos(wm._bar, 14, 12) _size(wm._bar, w - 4, 2) _vis(wm._bar, true)
    _pos(wm._text, 22, 17) _vis(wm._text, true)
end

local function _frame()
    if not S.alive then return end
    local now = tick()
    local dt = _clamp(now - S.lastT, 0, 0.1)
    S.lastT = now
    if dt > 0 then S.fps = S.fps + (1 / math.max(dt, 0.001) - S.fps) * 0.05 end
    S.vw, S.vh = _viewport()
    local active = _active()
    local mx, my = _mousePos()
    M.x, M.y = mx, my
    local down = _mouseDown() and active
    M.click = down and not M.down
    M.down = down
    _keys(active)
    for _, w in ipairs(S.windows) do _layout(w) end
    _input()
    for _, w in ipairs(S.windows) do _drawWin(w, dt) end
    _drawNotifs(now)
    _drawWatermark()
end

local function _step()
    local ok, e = pcall(_frame)
    if not ok and not S.errShown then
        S.errShown = true
        print("[QuantomLib] render error: " .. tostring(e))
    end
end

local function _connect()
    for _, n in ipairs({ "Render", "RenderStepped", "Heartbeat" }) do
        local ok, sig = pcall(function() return RunService[n] end)
        if ok and sig then
            local ok2, c = pcall(function() return sig:Connect(_step) end)
            if ok2 and c then
                S.conns[#S.conns + 1] = c
                return
            end
        end
    end
    task.spawn(function()
        while S.alive do
            _step()
            task.wait()
        end
    end)
end

S.lastT = tick()
_connect()

return QuantomLib
