function QuantomLib:Tab(name)
    local tab = setmetatable({ name = tostring(name or "Tab"), window = self, sections = {}, index = #self.tabs + 1, _all = {} }, TabMT)
    tab._bg = _new(tab._all, "Square", { Filled = true, Color = Theme.tab_active, Opacity = 0, ZIndex = self.z + 10 })
    tab._text = _new(tab._all, "Text", { Color = Theme.tab_text, Center = true, ZIndex = self.z + 12 })
