    self._shadow = _new(L, "Square", { Filled = true, Color = Theme.shadow, Opacity = 0.5, Rounding = 6, ZIndex = z })
    self._bg = _new(L, "Square", { Filled = true, Color = Theme.bg, Opacity = 0.98, Rounding = 4, ZIndex = z + 1 })
    self._border = _new(L, "Square", { Filled = false, Thickness = 1, Color = Theme.section_border, Opacity = 0.6, Rounding = 4, ZIndex = z + 2 })
