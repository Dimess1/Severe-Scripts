local function _clamp(v, a, b)
    if v < a then return a end
    if v > b then return b end
    return v
end

local function _round(v, d)
    local m = 10 ^ (d or 0)
    return math.floor(v * m + 0.5) / m
end

local function _ease(cur, target, speed, dt)
    local d = target - cur
    if d > -0.002 and d < 0.002 then return target, false end
    return cur + d * (1 - math.exp(-speed * dt)), true
end

local CC, CCn = {}, 0
local function _rgb(r, g, b)
    r, g, b = math.floor(r + 0.5), math.floor(g + 0.5), math.floor(b + 0.5)
    local key = r * 65536 + g * 256 + b
    local c = CC[key]
    if c then return c end
    if CCn > 4096 then CC, CCn = {}, 0 end
    c = Color3.fromRGB(r, g, b)
    CC[key] = c
    CCn = CCn + 1
    return c
end

local function _mix(k1, k2, t)
    if t <= 0.02 then return Theme[k1] end
    if t >= 0.98 then return Theme[k2] end
    local a, b = TC[k1], TC[k2]
    if not a or not b then return t < 0.5 and Theme[k1] or Theme[k2] end
    t = math.floor(t * 24 + 0.5) / 24
    return _rgb(a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t, a[3] + (b[3] - a[3]) * t)
end

local function _rd(c) return c.R, c.G, c.B end
local function _toRGB(c)
    local ok, r, g, b = pcall(_rd, c)
    if ok and type(r) == "number" and type(g) == "number" and type(b) == "number" then
        if r <= 1 and g <= 1 and b <= 1 then return { r * 255, g * 255, b * 255 } end
        return { r, g, b }
    end
    return nil
end

local function _setp(d, k, v) d[k] = v end
local function _raw(d, k, v) pcall(_setp, d, k, v) end

local function _set(w, k, v)
    if not w or w.dead then return end
    local c = w.c
    if c[k] == v then return end
    c[k] = v
    local d = w.d
    if k == "Opacity" then
        _raw(d, "Transparency", v)
    elseif k == "Rounding" then
        _raw(d, "Corner", v)
        _raw(d, "Rounding", v)
    elseif k == "TextSize" then
        _raw(d, "Size", v)
        _raw(d, "FontSize", v)
    elseif k == "Text" then
        _raw(d, "Text", v)
        w.tb = nil
    else
        _raw(d, k, v)
    end
end

local function _pos(w, x, y)
    if not w or w.dead then return end
    x, y = math.floor(x + 0.5), math.floor(y + 0.5)
    local c = w.c
    if c.px == x and c.py == y then return end
    c.px, c.py = x, y
    _raw(w.d, "Position", Vector2.new(x, y))
end

local function _size(w, x, y)
    if not w or w.dead then return end
    x, y = math.max(0, math.floor(x + 0.5)), math.max(0, math.floor(y + 0.5))
    local c = w.c
    if c.sx == x and c.sy == y then return end
    c.sx, c.sy = x, y
    _raw(w.d, "Size", Vector2.new(x, y))
end

local function _ln(w, x1, y1, x2, y2)
    if not w or w.dead then return end
    local c = w.c
    if c.l1 ~= x1 or c.l2 ~= y1 then
        c.l1, c.l2 = x1, y1
        _raw(w.d, "From", Vector2.new(x1, y1))
    end
    if c.l3 ~= x2 or c.l4 ~= y2 then
        c.l3, c.l4 = x2, y2
        _raw(w.d, "To", Vector2.new(x2, y2))
    end
end

local function _vis(w, v)
    if not w or w.dead then return end
    v = v and true or false
    if w.c.Visible == v then return end
    w.c.Visible = v
    _raw(w.d, "Visible", v)
end

local function _op(w, base)
    _set(w, "Opacity", base * CA)
end

local function _box(w, x, y, wd, ht, color, base)
    _pos(w, x, y)
    _size(w, wd, ht)
    _set(w, "Color", color)
    _set(w, "Opacity", (base or 1) * CA)
    _vis(w, true)
end

local function _txt(w, x, y, text, color, base)
    _set(w, "Text", text)
    _pos(w, x, y)
    _set(w, "Color", color)
    _set(w, "Opacity", (base or 1) * CA)
    _vis(w, true)
end

local function _newDraw(cls) return Drawing.new(cls) end

local function _new(list, cls, props, win)
    local ok, d = pcall(_newDraw, cls)
    if not ok or not d then return nil end
    local w = { d = d, c = {}, cls = cls }
    _raw(d, "Visible", false)
    w.c.Visible = false
    if cls == "Text" then
        _set(w, "Outline", false)
        _set(w, "Center", false)
        _set(w, "TextSize", 13)
        if FONT ~= nil then _set(w, "Font", FONT) end
    elseif cls == "Line" then
        _set(w, "Thickness", 1.5)
    end
    for k, v in pairs(props) do _set(w, k, v) end
    S.drawings[#S.drawings + 1] = w
    if list then list[#list + 1] = w end
    if win then win._every[#win._every + 1] = w end
    return w
end

local function _kill(w)
    if not w or w.dead then return end
    w.dead = true
    pcall(function() w.d:Remove() end)
end

local function _rdTB(d) return d.TextBounds end
local function _tw(w, s, size)
    if w and not w.dead and w.tb == nil then
        local ok, b = pcall(_rdTB, w.d)
        if ok and b and b.X and b.X > 0 then w.tb = b.X else w.tb = false end
    end
    if w and w.tb then return w.tb end
    return #tostring(s) * (size or 13) * 0.56
end

local function _hideList(list)
    for i = 1, #list do _vis(list[i], false) end
end

local function _kd(code)
    if not code then return false end
    local ok, v = pcall(iskeypressed, code)
    return ok and v == true
end

local function _active()
    local ok, v = pcall(isrbxactive)
    if ok and v == false then return false end
    return true
end

local function _md1() return isleftpressed() end
local function _md2() return ismouse1pressed() end
local function _md3() return iskeypressed(0x01) end
local MD = { _md1, _md2, _md3 }

local function _mouseDown()
    if S.mouseFn then
        local ok, v = pcall(S.mouseFn)
        if ok and type(v) == "boolean" then return v end
    end
    for _, f in ipairs(MD) do
        local ok, v = pcall(f)
        if ok and type(v) == "boolean" then
            S.mouseFn = f
            return v
        end
    end
    return false
end

local mouseObj = nil
local function _mlUIS() return UIS:GetMouseLocation() end
local function _mlObj() return mouseObj.X, mouseObj.Y end
local function _getMouse() mouseObj = LP:GetMouse() end

local function _mousePos()
    if S.posFn == 1 then
        local ok, p = pcall(_mlUIS)
        if ok and p then return p.X, p.Y end
    elseif S.posFn == 2 then
        local ok, x, y = pcall(_mlObj)
        if ok and x then return x, y end
    end
    if UIS then
        local ok, p = pcall(_mlUIS)
        if ok and p and p.X then
            S.posFn = 1
            return p.X, p.Y
        end
    end
    if LP then
        if not mouseObj then pcall(_getMouse) end
        if mouseObj then
            local ok, x, y = pcall(_mlObj)
            if ok and x then
                S.posFn = 2
                return x, y
            end
        end
    end
    return M.x, M.y
end

local function _rdVP() return workspace.CurrentCamera.ViewportSize end
local function _viewport()
    local ok, v = pcall(_rdVP)
    if ok and v and v.X and v.X > 0 then return v.X, v.Y end
    return S.vw, S.vh
end

local function _hit(x, y, w, h)
    return M.x >= x and M.x <= x + w and M.y >= y and M.y <= y + h
end

local function _fire(el, ...)
    if el.flag then QuantomLib.flags[el.flag] = el.value end
    if el.callback then
        local ok, e = pcall(el.callback, ...)
        if not ok then print("[QuantomLib] callback error: " .. tostring(e)) end
    end
end

local function _closeDD()
    if S.dropdown then S.dropdown.open = false end
    S.dropdown = nil
    S.dirty = true
end

local ElMT = {}
ElMT.__index = ElMT

function ElMT:Set(v, silent)
    local t = self.type
    if t == "label" then
        v = tostring(v)
        if self.text ~= v then
            self.text = v
            S.dirty = true
        end
        return self
    elseif t == "toggle" then
        v = v and true or false
    elseif t == "slider" then
        v = _round(_clamp(tonumber(v) or self.min, self.min, self.max), self.decimals)
    elseif t == "dropdown" then
        v = tostring(v)
    elseif t == "keybind" then
        v = _normKey(v)
        S.bindsDirty = true
    else
        return self
    end
    local changed = self.value ~= v
    self.value = v
    if self.flag then QuantomLib.flags[self.flag] = v end
    S.dirty = true
    if changed and not silent then _fire(self, v) end
    return self
end

function ElMT:Get()
    if self.type == "label" then return self.text end
    return self.value
end

function ElMT:SetText(t)
    if self.type == "label" then self.text = tostring(t) else self.name = tostring(t) end
    S.dirty = true
    return self
end

function ElMT:SetTip(t)
    self.tip = t and tostring(t) or nil
    return self
end

function ElMT:SetVisible(b)
    self.visible = b and true or false
    S.dirty = true
    return self
end

function ElMT:SetKeybind(k)
    self.keybind = _normKey(k)
    S.bindsDirty = true
    S.dirty = true
    return self
end

function ElMT:IsDown()
    local k = self.type == "keybind" and self.value or self.keybind
    return _kd(VK[k or ""])
end

function ElMT:SetOptions(opts, keep)
    if self.type ~= "dropdown" then return self end
    self.options = {}
    for i, o in ipairs(opts or {}) do self.options[i] = tostring(o) end
    if not keep then
        local found = false
        for _, o in ipairs(self.options) do if o == self.value then found = true break end end
        if not found then self:Set(self.options[1] or "None") end
    end
    S.dirty = true
    return self
end

local function _mk(el, cls, props)
    return _new(el._all, cls, props, el.window)
end

local function _el(sec, t, c)
    t.section = sec
    t.window = sec.tab.window
    t.visible = true
    t._all = {}
    t.anim = 0
    t.hv = 0
    t.tip = c and c.tip and tostring(c.tip) or nil
    setmetatable(t, ElMT)
    sec.elements[#sec.elements + 1] = t
    if t.flag then
        QuantomLib.flags[t.flag] = t.value
        S.flagEls[t.flag] = t
    end
    S.bindsDirty = true
    S.dirty = true
    return t
end

local function _h(el)
    local t = el.type
    if t == "toggle" then return 26
    elseif t == "slider" then return 40
    elseif t == "dropdown" then return 48
    elseif t == "keybind" then return 26
    elseif t == "button" then return 30
    elseif t == "separator" then return 12
    elseif t == "label" then
        local n = 1
        for _ in string.gmatch(el.text or "", "\n") do n = n + 1 end
        return 6 + n * 16
    end
    return 0
end

local SecMT = {}
SecMT.__index = SecMT

function SecMT:Toggle(c)
    c = c or {}
    local el = _el(self, {
        type = "toggle", name = tostring(c.name or ""), value = c.default and true or false,
        callback = c.callback, flag = c.flag, keybindCallback = c.keybindCallback,
        keybind = (c.keybind ~= nil or c.bindable) and _normKey(c.keybind) or nil
    }, c)
    el.anim = el.value and 1 or 0
    local z = self.z + 10
    el._text = _mk(el, "Text", { ZIndex = z + 2 })
    el._kb = _mk(el, "Text", { TextSize = 12, ZIndex = z + 2 })
    el._track = _mk(el, "Square", { Filled = true, Rounding = 7, ZIndex = z })
    el._knob = _mk(el, "Square", { Filled = true, Rounding = 5, ZIndex = z + 1 })
    return el
end

function SecMT:Slider(c)
    c = c or {}
    local mn, mx = tonumber(c.min) or 0, tonumber(c.max) or 100
    if mx <= mn then mx = mn + 1 end
    local el = _el(self, {
        type = "slider", name = tostring(c.name or ""), min = mn, max = mx,
        decimals = math.max(0, math.floor(tonumber(c.decimals) or 2)), suffix = c.suffix or "",
        callback = c.callback, flag = c.flag, value = mn
    }, c)
    el.value = _round(_clamp(tonumber(c.default) or mn, mn, mx), el.decimals)
    el.pv = (el.value - mn) / (mx - mn)
    el.kv = 0
    if el.flag then QuantomLib.flags[el.flag] = el.value end
    local z = self.z + 10
    el._text = _mk(el, "Text", { ZIndex = z + 2 })
    el._val = _mk(el, "Text", { ZIndex = z + 2 })
    el._bg = _mk(el, "Square", { Filled = true, Rounding = 3, ZIndex = z })
    el._fill = _mk(el, "Square", { Filled = true, Rounding = 3, ZIndex = z + 1 })
    el._knob = _mk(el, "Square", { Filled = true, Rounding = 6, ZIndex = z + 2 })
    return el
end

function SecMT:Dropdown(c)
    c = c or {}
    local opts = {}
    for i, o in ipairs(c.options or {}) do opts[i] = tostring(o) end
    local el = _el(self, {
        type = "dropdown", name = tostring(c.name or ""), options = opts,
        value = tostring(c.default or opts[1] or "None"), callback = c.callback, flag = c.flag, open = false
    }, c)
    el.oa = 0
    local z = self.z + 10
    el._label = _mk(el, "Text", { TextSize = 12, ZIndex = z })
    el._bg = _mk(el, "Square", { Filled = true, Rounding = 5, ZIndex = z + 1 })
    el._border = _mk(el, "Square", { Filled = false, Thickness = 1, Rounding = 5, ZIndex = z + 2 })
    el._val = _mk(el, "Text", { ZIndex = z + 3 })
    el._ch1 = _mk(el, "Line", { ZIndex = z + 3 })
    el._ch2 = _mk(el, "Line", { ZIndex = z + 3 })
    el._opts = {}
    el._ovAll = {}
    el._ovBg = _new(el._ovAll, "Square", { Filled = true, Rounding = 5, ZIndex = S.zTop }, el.window)
    el._ovBorder = _new(el._ovAll, "Square", { Filled = false, Thickness = 1, Rounding = 5, ZIndex = S.zTop + 4 }, el.window)
    return el
end

function SecMT:Keybind(c)
    c = c or {}
    local el = _el(self, {
        type = "keybind", name = tostring(c.name or ""), value = _normKey(c.default),
        callback = c.callback, pressed = c.pressed, flag = c.flag
    }, c)
    local z = self.z + 10
    el._text = _mk(el, "Text", { ZIndex = z + 1 })
    el._bg = _mk(el, "Square", { Filled = true, Rounding = 5, ZIndex = z })
