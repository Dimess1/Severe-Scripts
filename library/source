function QuantomLib.new(cfg)
    cfg = cfg or {}
    local self = setmetatable({}, QuantomLib)
    self.title = tostring(cfg.title or "Quantom.gg")
    self.subtitle = cfg.subtitle and tostring(cfg.subtitle) or nil
    self.x = cfg.x or 100
    self.y = cfg.y or 100
    self.width = cfg.width or 620
    self.height = cfg.height or 420
    self.minHeight = cfg.minHeight or 150
    if cfg.autoSize ~= nil then self.autoSize = cfg.autoSize and true or false else self.autoSize = cfg.height == nil end
    self.visible = cfg.visible ~= false
    self.A = self.visible and 0 or 0
    self.toggleKey = cfg.toggleKey ~= nil and _normKey(cfg.toggleKey) or "Insert"
    self.tabs = {}
    self.activeTab = nil
    self.dragging = false
    self.dragOX, self.dragOY = 0, 0
    self.H = self.height
    self._all = {}
    self._every = {}
    self.pillX, self.pillW = nil, nil
    local z = S.zBase
    S.zBase = S.zBase + 100
    self.z = z
    local L = self._all
    self._sh1 = _new(L, "Square", { Filled = true, Rounding = 12, ZIndex = z }, self)
    self._sh2 = _new(L, "Square", { Filled = true, Rounding = 10, ZIndex = z + 1 }, self)
    self._sh3 = _new(L, "Square", { Filled = true, Rounding = 9, ZIndex = z + 2 }, self)
    self._bg = _new(L, "Square", { Filled = true, Rounding = 8, ZIndex = z + 3 }, self)
    self._border = _new(L, "Square", { Filled = false, Thickness = 1, Rounding = 8, ZIndex = z + 4 }, self)
    self._titlebar = _new(L, "Square", { Filled = true, Rounding = 8, ZIndex = z + 5 }, self)
    self._titlefix = _new(L, "Square", { Filled = true, ZIndex = z + 5 }, self)
    self._title = _new(L, "Text", { TextSize = 15, ZIndex = z + 6 }, self)
    self._div = _new(L, "Square", { Filled = true, ZIndex = z + 6 }, self)
    self._sub = _new(L, "Text", { TextSize = 12, ZIndex = z + 6 }, self)
    self._hint = _new(L, "Text", { TextSize = 12, ZIndex = z + 6 }, self)
    self._accent = _new(L, "Square", { Filled = true, ZIndex = z + 7 }, self)
    self._glow = _new(L, "Square", { Filled = true, ZIndex = z + 7 }, self)
    self._tabbar = _new(L, "Square", { Filled = true, ZIndex = z + 5 }, self)
    self._pill = _new(L, "Square", { Filled = true, Rounding = 6, ZIndex = z + 8 }, self)
    self._uline = _new(L, "Square", { Filled = true, Rounding = 1, ZIndex = z + 10 }, self)
    S.windows[#S.windows + 1] = self
    S.bindsDirty = true
    S.dirty = true
    return self
end

function QuantomLib:Tab(name)
    local tab = setmetatable({ name = tostring(name or "Tab"), window = self, sections = {}, index = #self.tabs + 1, _all = {}, hv = 0 }, TabMT)
    tab._text = _new(tab._all, "Text", { Center = true, ZIndex = self.z + 9 }, self)
    self.tabs[#self.tabs + 1] = tab
    if not self.activeTab then self.activeTab = tab end
    S.dirty = true
    return tab
end

function QuantomLib:SetTheme(overrides)
    for k, v in pairs(overrides or {}) do
        Theme[k] = v
        TC[k] = _toRGB(v)
    end
    S.dirty = true
end

function QuantomLib:SetAccent(c)
    local rgb = _toRGB(c)
    local dark = c
    if rgb then dark = _rgb(rgb[1] * 0.6, rgb[2] * 0.6, rgb[3] * 0.6) end
    self:SetTheme({ accent = c, tab_text_active = c, toggle_on = c, slider_fill = c, accent_dark = dark })
end

function QuantomLib:Toggle()
    self.visible = not self.visible
    if not self.visible then _closeDD() end
    S.dirty = true
end

function QuantomLib:SetVisible(b)
    self.visible = b and true or false
    if not self.visible then _closeDD() end
    S.dirty = true
end

function QuantomLib:SetTitle(t)
    self.title = tostring(t)
    S.dirty = true
end

function QuantomLib:SetRenderPaused(b)
    S.paused = b and true or false
    if not S.paused then S.dirty = true end
end

function QuantomLib:Notify(text, title, duration, kind)
    local n = {
        text = tostring(text or ""), title = tostring(title or "Quantom"), dur = tonumber(duration) or 3,
        t0 = tick(), _all = {}, y = nil, kind = (kind == "success" or kind == "warning" or kind == "error") and kind or "accent"
    }
    local z = S.zTop + 20
    n._bg = _new(n._all, "Square", { Filled = true, Rounding = 6, ZIndex = z })
    n._border = _new(n._all, "Square", { Filled = false, Thickness = 1, Rounding = 6, ZIndex = z + 1 })
    n._bar = _new(n._all, "Square", { Filled = true, Rounding = 1, ZIndex = z + 2 })
    n._prog = _new(n._all, "Square", { Filled = true, Rounding = 1, ZIndex = z + 2 })
    n._title = _new(n._all, "Text", { TextSize = 13, ZIndex = z + 3 })
    n._text = _new(n._all, "Text", { TextSize = 12, ZIndex = z + 3 })
    S.notifs[#S.notifs + 1] = n
    while #S.notifs > 6 do
        local old = table.remove(S.notifs, 1)
        for _, w in ipairs(old._all) do _kill(w) end
    end
    return n
end

function QuantomLib:Watermark(text)
    if S.wm then
        S.wm.text = tostring(text or "")
        S.wm.visible = true
        return S.wm
    end
    local wm = { text = tostring(text or "quantom.gg"), visible = true, _all = {}, shown = nil, fpsT = 0 }
    local z = S.zTop + 10
    wm._bg = _new(wm._all, "Square", { Filled = true, Rounding = 6, ZIndex = z })
    wm._border = _new(wm._all, "Square", { Filled = false, Thickness = 1, Rounding = 6, ZIndex = z + 1 })
    wm._dot = _new(wm._all, "Square", { Filled = true, Rounding = 3, ZIndex = z + 2 })
    wm._text = _new(wm._all, "Text", { TextSize = 13, ZIndex = z + 2 })
    function wm:Set(t) self.text = tostring(t) self.fpsT = 0 return self end
    function wm:SetVisible(b) self.visible = b and true or false self.fpsT = 0 return self end
    S.wm = wm
    return wm
end

function QuantomLib:SaveConfig(name)
    if not HttpService then return false end
    local data = {}
    for flag, el in pairs(S.flagEls) do
        data[flag] = el.value
        if el.type == "toggle" and el.keybind then data[flag .. "__key"] = el.keybind end
    end
    local ok, s = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok or type(s) ~= "string" then return false end
    pcall(makefolder, "QuantomLib")
    local ok2 = pcall(writefile, "QuantomLib/" .. tostring(name or "default") .. ".json", s)
    return ok2
end

function QuantomLib:LoadConfig(name)
    if not HttpService then return false end
    local ok, raw = pcall(readfile, "QuantomLib/" .. tostring(name or "default") .. ".json")
    if not ok or type(raw) ~= "string" then return false end
    local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok2 or type(data) ~= "table" then return false end
    for flag, el in pairs(S.flagEls) do
        if data[flag] ~= nil then el:Set(data[flag]) end
        if el.type == "toggle" and data[flag .. "__key"] ~= nil then el.keybind = _normKey(data[flag .. "__key"]) end
    end
    S.bindsDirty = true
    return true
end

function QuantomLib:ListConfigs()
    local out = {}
    local ok, files = pcall(listfiles, "QuantomLib")
    if ok and type(files) == "table" then
        for _, f in ipairs(files) do
            local n = string.match(tostring(f), "([^/\\]+)%.json$")
            if n then out[#out + 1] = n end
        end
    end
    return out
end

function QuantomLib:Destroy()
    S.alive = false
    for _, c in ipairs(S.conns) do pcall(function() c:Disconnect() end) end
    S.conns = {}
    for _, w in ipairs(S.drawings) do _kill(w) end
    S.drawings, S.windows, S.notifs = {}, {}, {}
    S.dropdown, S.listening, S.slider, S.dragWin, S.wm = nil, nil, nil, nil, nil
end

local function _rebuildBinds(now)
    local list, els, seen = {}, {}, {}
    for _, w in ipairs(S.windows) do
        local tk = w.toggleKey
        if tk and VK[tk] and not seen[tk] then
            seen[tk] = true
            list[#list + 1] = tk
        end
        for _, tab in ipairs(w.tabs) do
            for _, sec in ipairs(tab.sections) do
                for _, el in ipairs(sec.elements) do
                    local k = nil
                    if el.type == "toggle" then k = el.keybind elseif el.type == "keybind" then k = el.value end
                    if k and VK[k] then
                        els[#els + 1] = el
                        if not seen[k] then
                            seen[k] = true
                            list[#list + 1] = k
                        end
                    end
                end
            end
        end
    end
    S.binds, S.bindEls = list, els
    S.bindsDirty = false
    S.bindT = now
end

local function _applyBind(L, v)
    local el = L.el
    if L.field == "keybind" then
        el.keybind = v
        if el.keybindCallback then pcall(el.keybindCallback, v) end
    else
        el:Set(v)
    end
    S.bindsDirty = true
    S.dirty = true
end

local function _keys(active, now)
    if S.listening then
        if S.listenArm then
            local any = M.down
            if not any then
                for i = 1, #VK_ORDER do
                    if _kd(VK[VK_ORDER[i]]) then any = true break end
                end
            end
            if not any then S.listenArm = false end
        else
            for i = 1, #VK_ORDER do
                local n = VK_ORDER[i]
                if _kd(VK[n]) then
                    local v = n
                    if n == "Escape" or n == "Backspace" then v = "Unbound" end
                    S.kprev[n] = true
                    local L = S.listening
                    S.listening = nil
                    _applyBind(L, v)
                    break
                end
            end
        end
        return
    end
    if S.bindsDirty or now - S.bindT > 1 then _rebuildBinds(now) end
    local st, pv = S.kstate, S.kprev
    local binds = S.binds
    for i = 1, #binds do
        local n = binds[i]
        st[n] = active and _kd(VK[n]) or false
    end
    for _, w in ipairs(S.windows) do
        local tk = w.toggleKey
        if tk and st[tk] and not pv[tk] then
            w.visible = not w.visible
            if not w.visible then _closeDD() end
            S.dirty = true
        end
    end
    local els = S.bindEls
    for i = 1, #els do
        local el = els[i]
        if el.type == "toggle" then
            local k = el.keybind
            if k and st[k] and not pv[k] then el:Set(not el.value) end
        elseif el.type == "keybind" and el.pressed then
            local k = el.value
            if st[k] and not pv[k] then
                local ok, e = pcall(el.pressed, k)
                if not ok then print("[QuantomLib] keybind error: " .. tostring(e)) end
            end
        end
    end
    for i = 1, #binds do
        local n = binds[i]
        pv[n] = st[n]
    end
end

local function _layout(w)
    local x, y, W = w.x, w.y, w.width
    local tab = w.activeTab
    local cX, cY = x + 10, y + 79
    local hW = math.floor((W - 20) / 2) - 4
    local lY, rY = cY, cY
    for _, t in ipairs(w.tabs) do
        if t ~= tab then
            for _, sec in ipairs(t.sections) do
                sec.rx = nil
                for _, el in ipairs(sec.elements) do el.rx = nil end
            end
        end
    end
    if tab then
        for _, sec in ipairs(tab.sections) do
            local isL = sec.side ~= "right"
            local sX = isL and cX or (cX + hW + 8)
            local sY = isL and lY or rY
            local h = 38
            for _, el in ipairs(sec.elements) do
                if el.visible then h = h + _h(el) end
            end
            h = h + 6
            sec.rx, sec.ry, sec.rw, sec.rh = sX, sY, hW, h
            local eY = sY + 38
            for _, el in ipairs(sec.elements) do
                if el.visible then
                    el.rx, el.ry, el.rw, el.rh = sX + 12, eY, hW - 24, _h(el)
                    eY = eY + el.rh
                else
                    el.rx = nil
                end
            end
            if isL then lY = lY + h + 8 else rY = rY + h + 8 end
        end
    end
    if w.autoSize then
        w.H = math.max(w.minHeight, math.max(lY, rY) - y + 2)
    else
        w.H = w.height
    end
end

local function _slideTo(el)
    local p = _clamp((M.x - el.rx) / math.max(el.rw, 1), 0, 1)
    el:Set(el.min + p * (el.max - el.min))
end

local function _ddGeom(el)
    local n = #el.options
    local listH = n * 24 + 4
    local oy = el.ry + 47
    if oy + listH > S.vh - 8 and el.ry + 17 - listH > 8 then oy = el.ry + 17 - listH end
    return oy, listH
end

local function _elClick(el)
    local t = el.type
    if t == "toggle" then
        local kbX = el.rx + el.rw - 38 - (el.kbW or 0)
        if el.keybind and M.x >= kbX - 4 and M.x <= el.rx + el.rw - 36 then
            S.listening = { el = el, field = "keybind" }
            S.listenArm = true
        else
            el:Set(not el.value)
        end
    elseif t == "slider" then
        if M.y >= el.ry + 16 then
            S.slider = el
            _slideTo(el)
        end
    elseif t == "dropdown" then
        if M.y >= el.ry + 17 then
            if el.open then
                _closeDD()
            else
                _closeDD()
                el.open = true
                S.dropdown = el
            end
        end
    elseif t == "keybind" then
        S.listening = { el = el, field = "value" }
        S.listenArm = true
    elseif t == "button" then
        el.flash = 1
        _fire(el)
    end
    S.dirty = true
end

local function _windowClick(w)
    if M.y <= w.y + 36 then
        S.dragWin = w
        w.dragging = true
        w.dragOX, w.dragOY = M.x - w.x, M.y - w.y
        return
    end
    if M.y <= w.y + 69 then
        local n = #w.tabs
        if n == 0 then return end
        local i = _clamp(math.floor((M.x - w.x - 6) / ((w.width - 12) / n)) + 1, 1, n)
        if w.tabs[i] ~= w.activeTab then
            w.activeTab = w.tabs[i]
            _closeDD()
        end
        return
    end
    local tab = w.activeTab
    if not tab then return end
    for _, sec in ipairs(tab.sections) do
        if sec.rx and _hit(sec.rx, sec.ry, sec.rw, sec.rh) then
            for _, el in ipairs(sec.elements) do
                if el.rx and _hit(el.rx, el.ry, el.rw, el.rh) then
                    _elClick(el)
                    return
                end
            end
            return
        end
    end
end

local function _input()
    if S.dragWin then
        local w = S.dragWin
        if M.down then
            w.x = _clamp(M.x - w.dragOX, 0, math.max(0, S.vw - w.width))
            w.y = _clamp(M.y - w.dragOY, 0, math.max(0, S.vh - 36))
        else
            w.dragging = false
            S.dragWin = nil
        end
    end
    if S.slider then
        if M.down and S.slider.rx then _slideTo(S.slider) else S.slider = nil end
    end
    if not M.click then return end
    if S.listening then
        S.listening = nil
        M.click = false
        return
    end
    local dd = S.dropdown
    if dd then
        if dd.rx and dd.window.visible then
            local oy = _ddGeom(dd)
            for i = 1, #dd.options do
                if _hit(dd.rx, oy + 2 + (i - 1) * 24, dd.rw, 24) then
                    _closeDD()
                    dd:Set(dd.options[i])
                    M.click = false
                    return
                end
            end
            if not _hit(dd.rx, dd.ry + 17, dd.rw, 26) then
                _closeDD()
                M.click = false
                return
            end
        else
            _closeDD()
        end
    end
    for i = #S.windows, 1, -1 do
        local w = S.windows[i]
        if w.visible and _hit(w.x, w.y, w.width, w.H) then
            _windowClick(w)
            M.click = false
            return
        end
    end
end

local function _drawEl(el, on, dt)
    if not on or not el.rx then
        _hideList(el._all)
        if el._ovAll then _hideList(el._ovAll) end
        el.hv = 0
        return false
    end
    local anim = false
    local a
    local x, y, w = el.rx, el.ry, el.rw
    local hovTarget = (_hit(x, y, w, el.rh) and S.dropdown == nil and S.dragWin == nil) and 1 or 0
    el.hv, a = _ease(el.hv, hovTarget, 18, dt)
    anim = anim or a
    if hovTarget == 1 and el.tip then
        if S.hoverEl ~= el then
            S.hoverEl = el
            S.hoverT = tick()
        end
        anim = true
    elseif S.hoverEl == el then
        S.hoverEl = nil
    end
    local hv = el.hv
    local t = el.type
    if t == "toggle" then
        el.anim, a = _ease(el.anim, el.value and 1 or 0, 16, dt)
        anim = anim or a
        local tx, ty = x + w - 30, y + 6
        _txt(el._text, x, y + 6, el.name, _mix("text", "text_hover", math.max(hv, el.anim * 0.55)))
        _box(el._track, tx, ty, 30, 14, _mix("toggle_off", "toggle_on", el.anim))
        _box(el._knob, tx + 2 + el.anim * 16, ty + 2, 10, 10, Theme.knob)
        if el.keybind then
            local listening = S.listening and S.listening.el == el and S.listening.field == "keybind"
            local s = listening and "[ ... ]" or ("[" .. el.keybind .. "]")
            _set(el._kb, "Text", s)
            local kw = _tw(el._kb, s, 12)
            el.kbW = kw
            _txt(el._kb, tx - 8 - kw, y + 7, s, listening and Theme.accent or Theme.text_dim)
        else
            _vis(el._kb, false)
        end
    elseif t == "slider" then
        local target = (el.value - el.min) / (el.max - el.min)
        el.pv, a = _ease(el.pv, target, 22, dt)
        anim = anim or a
        local active = S.slider == el
        el.kv, a = _ease(el.kv, (active or hv > 0.5) and 1 or 0, 18, dt)
        anim = anim or a
        if el._vsv ~= el.value then
            el._vsv = el.value
            el._vs = string.format("%." .. el.decimals .. "f", el.value) .. el.suffix
        end
        local vs = el._vs
        _txt(el._text, x, y + 3, el.name, _mix("text", "text_hover", math.max(hv, active and 1 or 0)))
        _set(el._val, "Text", vs)
        _txt(el._val, x + w - _tw(el._val, vs, 13), y + 3, vs, Theme.accent)
        local pct = el.pv
        _box(el._bg, x, y + 25, w, 6, Theme.slider_bg)
        _box(el._fill, x, y + 25, math.max(6, w * pct), 6, Theme.slider_fill)
        local ks = 12 + el.kv * 2
        _set(el._knob, "Rounding", math.floor(ks / 2))
        _box(el._knob, x + w * pct - ks / 2, y + 28 - ks / 2, ks, ks, Theme.knob)
    elseif t == "dropdown" then
        el.oa, a = _ease(el.oa, el.open and 1 or 0, 20, dt)
        anim = anim or a
        _txt(el._label, x, y + 2, el.name, Theme.text_dim)
        _box(el._bg, x, y + 17, w, 26, _mix("dropdown_bg", "dropdown_hover", math.max(hv, el.oa)))
        _box(el._border, x, y + 17, w, 26, _mix("section_border", "accent_dark", math.max(hv * 0.6, el.oa)))
        _txt(el._val, x + 9, y + 23, el.value, Theme.text_hover)
        local cx, cy = x + w - 14, y + 30
        local dy = 2 - el.oa * 4
        local col = _mix("text_dim", "accent", el.oa)
        _ln(el._ch1, cx - 4, cy - dy, cx, cy + dy)
        _ln(el._ch2, cx, cy + dy, cx + 4, cy - dy)
        _set(el._ch1, "Color", col)
        _set(el._ch2, "Color", col)
        _op(el._ch1, 1)
        _op(el._ch2, 1)
        _vis(el._ch1, true)
        _vis(el._ch2, true)
        for i = #el._opts + 1, #el.options do
            el._opts[i] = {
                bg = _new(el._ovAll, "Square", { Filled = true, Rounding = 4, ZIndex = S.zTop + 1 }, el.window),
                bar = _new(el._ovAll, "Square", { Filled = true, Rounding = 1, ZIndex = S.zTop + 2 }, el.window),
                text = _new(el._ovAll, "Text", { ZIndex = S.zTop + 3 }, el.window)
            }
        end
        local oy, listH = _ddGeom(el)
        local shown = el.oa > 0.02 and #el.options > 0
        if shown then
            local hcur = listH * el.oa
            local up = oy < y
            local top = up and (oy + listH - hcur) or oy
            _box(el._ovBg, x, top, w, hcur, Theme.dropdown_item, 1)
            _box(el._ovBorder, x, top, w, hcur, Theme.accent_dark, 0.9)
            for i, o in ipairs(el._opts) do
                local opt = el.options[i]
                local ry = oy + 2 + (i - 1) * 24
                local inside = opt ~= nil and ry >= top - 1 and ry + 24 <= top + hcur + 1
                if inside then
                    local oh = el.open and _hit(x, ry, w, 24)
                    local sel = opt == el.value
                    _box(o.bg, x + 3, ry + 1, w - 6, 22, oh and Theme.dropdown_hover or Theme.dropdown_item, oh and 1 or 0)
                    if sel then _box(o.bar, x + 6, ry + 6, 2, 12, Theme.accent) else _vis(o.bar, false) end
                    _txt(o.text, x + 14, ry + 5, opt, sel and Theme.accent or (oh and Theme.text_hover or Theme.text))
                else
                    _vis(o.bg, false)
                    _vis(o.bar, false)
                    _vis(o.text, false)
                end
            end
        else
            _hideList(el._ovAll)
        end
    elseif t == "keybind" then
        local listening = S.listening and S.listening.el == el and S.listening.field == "value"
        local s = listening and "..." or el.value
        _txt(el._text, x, y + 6, el.name, _mix("text", "text_hover", hv))
        _set(el._val, "Text", s)
        local kw = math.max(58, _tw(el._val, s, 12) + 20)
        _box(el._bg, x + w - kw, y + 3, kw, 20, _mix("keybind_bg", "dropdown_hover", math.max(hv, listening and 1 or 0)))
        _box(el._border, x + w - kw, y + 3, kw, 20, listening and Theme.accent or _mix("section_border", "accent_dark", hv))
        _txt(el._val, x + w - kw / 2, y + 7, s, listening and Theme.accent or _mix("text_dim", "text_hover", hv))
    elseif t == "button" then
        el.flash, a = _ease(el.flash, 0, 6, dt)
        anim = anim or a
        local bg = el.flash > 0.05 and _mix("button_hover", "accent_dark", el.flash) or _mix("button_bg", "button_hover", hv)
        _box(el._bg, x, y + 3, w, 24, bg)
        _box(el._border, x, y + 3, w, 24, _mix("section_border", "accent_dark", math.max(hv, el.flash)))
        _txt(el._text, x + w / 2, y + 8, el.name, _mix("text", "text_hover", hv))
    elseif t == "separator" then
        _box(el._line, x, y + 6, w, 1, Theme.separator, 0.8)
    elseif t == "label" then
        _set(el._text, "TextSize", el.tsize)
        _txt(el._text, x, y + 3, el.text, el.color or Theme.text_dim)
    end
    return anim
end

local function _drawWin(w, dt)
    local anim, a = false, nil
    w.A, a = _ease(w.A, w.visible and 1 or 0, 14, dt)
    anim = anim or a
    if w.A <= 0.01 and not w.visible then
        if not w.hiddenAll then
            _hideList(w._every)
            w.hiddenAll = true
        end
        return anim
    end
    w.hiddenAll = false
    CA = w.A
    local x, y, W, H = w.x, w.y, w.width, w.H
    _box(w._sh1, x - 6, y - 6, W + 12, H + 12, Theme.shadow, 0.10)
    _box(w._sh2, x - 4, y - 4, W + 8, H + 8, Theme.shadow, 0.16)
    _box(w._sh3, x - 2, y - 2, W + 4, H + 4, Theme.shadow, 0.24)
    _box(w._bg, x, y, W, H, Theme.bg, 0.98)
    _box(w._border, x, y, W, H, Theme.section_border, 0.9)
    _box(w._titlebar, x, y, W, 36, Theme.titlebar)
    _box(w._titlefix, x, y + 26, W, 10, Theme.titlebar)
    _txt(w._title, x + 14, y + 10, w.title, Theme.accent)
    local tw = _tw(w._title, w.title, 15)
    if w.subtitle then
        _box(w._div, x + 24 + tw, y + 12, 1, 13, Theme.section_border)
        _txt(w._sub, x + 34 + tw, y + 11, w.subtitle, Theme.text_dim)
    else
        _vis(w._div, false)
        _vis(w._sub, false)
    end
    local hint = (w.toggleKey and w.toggleKey ~= "Unbound") and ("[" .. w.toggleKey .. "]") or ""
    _set(w._hint, "Text", hint)
    _txt(w._hint, x + W - 14 - _tw(w._hint, hint, 12), y + 11, hint, Theme.text_dim, 0.8)
    _box(w._accent, x, y + 36, W, 1, Theme.accent, 0.9)
    _box(w._glow, x, y + 37, W, 1, Theme.accent, 0.22)
    _box(w._tabbar, x, y + 38, W, 31, Theme.tab_bg)
    local n = math.max(#w.tabs, 1)
    local tW = (W - 12) / n
    for i, tab in ipairs(w.tabs) do
        local tx = x + 6 + (i - 1) * tW
        local act = tab == w.activeTab
        tab.hv, a = _ease(tab.hv, (_hit(tx, y + 38, tW, 31) and not act) and 1 or 0, 18, dt)
        anim = anim or a
        if act then
            local tpx, tpw = tx + 4, tW - 8
            if not w.pillX then w.pillX, w.pillW = tpx, tpw end
            w.pillX, a = _ease(w.pillX, tpx, 16, dt)
            anim = anim or a
            w.pillW, a = _ease(w.pillW, tpw, 16, dt)
            anim = anim or a
        end
        _txt(tab._text, tx + tW / 2, y + 46, tab.name, act and Theme.tab_text_active or _mix("tab_text", "text", tab.hv))
        for _, sec in ipairs(tab.sections) do
            local on = act and sec.rx ~= nil
            if on then
                _box(sec._bg, sec.rx, sec.ry, sec.rw, sec.rh, Theme.section_bg)
                _box(sec._border, sec.rx, sec.ry, sec.rw, sec.rh, Theme.section_border, 0.9)
                _box(sec._mark, sec.rx + 12, sec.ry + 12, 3, 12, Theme.accent)
                _txt(sec._title, sec.rx + 21, sec.ry + 10, sec.name, Theme.section_title)
                _box(sec._line, sec.rx + 12, sec.ry + 31, sec.rw - 24, 1, Theme.separator, 0.8)
            else
                _hideList(sec._all)
            end
            for _, el in ipairs(sec.elements) do
                if _drawEl(el, on and el.visible, dt) then anim = true end
            end
        end
    end
    if w.pillX and #w.tabs > 0 then
        _box(w._pill, w.pillX, y + 42, w.pillW, 23, Theme.accent, 0.13)
        _box(w._uline, w.pillX + w.pillW / 2 - 9, y + 63, 18, 2, Theme.accent)
    else
        _vis(w._pill, false)
        _vis(w._uline, false)
    end
    CA = 1
    return anim
end

local TIP = { _all = {} }
local function _drawTip(now)
    local el = S.hoverEl
    if not TIP._bg then
        TIP._bg = _new(TIP._all, "Square", { Filled = true, Rounding = 5, ZIndex = S.zTop + 60 })
        TIP._border = _new(TIP._all, "Square", { Filled = false, Thickness = 1, Rounding = 5, ZIndex = S.zTop + 61 })
        TIP._text = _new(TIP._all, "Text", { TextSize = 12, ZIndex = S.zTop + 62 })
    end
    if not el or not el.tip or not el.rx or not el.window.visible or S.listening or S.dragWin or S.slider or now - S.hoverT < 0.45 then
        _hideList(TIP._all)
        return el ~= nil and el.tip ~= nil
    end
    local a = _clamp((now - S.hoverT - 0.45) / 0.15, 0, 1)
    CA = a
    _set(TIP._text, "Text", el.tip)
    local tw = _tw(TIP._text, el.tip, 12)
    local bx = _clamp(M.x + 14, 4, S.vw - tw - 22)
    local by = _clamp(M.y + 18, 4, S.vh - 28)
    _box(TIP._bg, bx, by, tw + 16, 22, Theme.notify_bg, 0.97)
    _box(TIP._border, bx, by, tw + 16, 22, Theme.accent_dark, 0.9)
    _txt(TIP._text, bx + 8, by + 4, el.tip, Theme.text)
    CA = 1
    return a < 1
end

local function _drawNotifs(now, dt)
    local by = S.vh - 16
    local i = #S.notifs
    while i >= 1 do
        local n = S.notifs[i]
        local age = now - n.t0
        if age >= n.dur + 0.35 then
            for _, w in ipairs(n._all) do _kill(w) end
            table.remove(S.notifs, i)
        else
            local a = _clamp(math.min(age / 0.22, (n.dur + 0.35 - age) / 0.35), 0, 1)
            local e = 1 - (1 - a) * (1 - a)
            local nw = math.max(240, math.min(380, #n.text * 6.6 + 40))
            local nh = 54
            local ty = by - nh
            if n.y == nil then n.y = ty end
            n.y = n.y + (ty - n.y) * (1 - math.exp(-14 * dt))
            local nx = S.vw - 16 - nw + (1 - e) * 50
            CA = a
            local kc = n.kind == "accent" and Theme.accent or Theme[n.kind]
            _box(n._bg, nx, n.y, nw, nh, Theme.notify_bg, 0.97)
            _box(n._border, nx, n.y, nw, nh, Theme.section_border, 1)
            _box(n._bar, nx + 6, n.y + 10, 3, nh - 20, kc)
            local p = _clamp(1 - age / n.dur, 0, 1)
            _box(n._prog, nx + 16, n.y + nh - 7, (nw - 32) * p, 2, kc, 0.6)
            _txt(n._title, nx + 18, n.y + 10, n.title, kc)
            _txt(n._text, nx + 18, n.y + 28, n.text, Theme.text)
            CA = 1
            by = n.y - 10
        end
        i = i - 1
    end
end

local function _drawWatermark(now)
    local wm = S.wm
    if not wm then return end
    if not wm.visible then
        _hideList(wm._all)
        return
    end
    if now - wm.fpsT < 0.25 and wm.shown then return end
    wm.fpsT = now
    local s = string.gsub(wm.text, "{fps}", tostring(math.floor(S.fps + 0.5)))
    wm.shown = s
    _set(wm._text, "Text", s)
    local tw = _tw(wm._text, s, 13)
    local w = tw + 34
    _box(wm._bg, 12, 12, w, 26, Theme.bg, 0.96)
    _box(wm._border, 12, 12, w, 26, Theme.section_border, 1)
    _box(wm._dot, 22, 22, 6, 6, Theme.accent)
    _txt(wm._text, 36, 17, s, Theme.text)
end

local function _frame()
    if not S.alive then return end
    local now = tick()
    local dt = _clamp(now - S.lastT, 0, 0.1)
    S.lastT = now
    if dt > 0 then S.fps = S.fps + (1 / math.max(dt, 0.001) - S.fps) * 0.05 end
    if S.paused then return end
    if now - S.vpT > 0.5 then
        S.vpT = now
        local vw, vh = _viewport()
        if vw ~= S.vw or vh ~= S.vh then S.vw, S.vh, S.dirty = vw, vh, true end
    end
    local active = _active()
    local mx, my = _mousePos()
    local down = _mouseDown() and active
    M.click = down and not M.down
    local moved = mx ~= M.x or my ~= M.y
    local btn = down ~= M.down
    M.x, M.y, M.down = mx, my, down
    _keys(active, now)
    if S.dirty or S.anim or moved or btn or S.listening or now - S.fullT > 0.25 then
        S.dirty = false
        S.fullT = now
        for i = 1, #S.windows do _layout(S.windows[i]) end
        _input()
        local anim = false
        for i = 1, #S.windows do
            if _drawWin(S.windows[i], dt) then anim = true end
        end
        if _drawTip(now) then anim = true end
        S.anim = anim
    end
    _drawNotifs(now, dt)
    _drawWatermark(now)
end

local function _step()
    local ok, e = pcall(_frame)
    if not ok and not S.errShown then
        S.errShown = true
        print("[QuantomLib] render error: " .. tostring(e))
    end
end

local function _connect()
    for _, n in ipairs({ "Render", "RenderStepped", "Heartbeat" }) do
        local ok, sig = pcall(function() return RunService[n] end)
        if ok and sig then
            local ok2, c = pcall(function() return sig:Connect(_step) end)
            if ok2 and c then
                S.conns[#S.conns + 1] = c
                return
            end
        end
    end
    task.spawn(function()
        while S.alive do
            _step()
            task.wait()
        end
    end)
end

S.lastT = tick()
_connect()

_G.QuantomLib = QuantomLib
return QuantomLib
